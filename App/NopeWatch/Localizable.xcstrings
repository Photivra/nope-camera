{
  "sourceLanguage": "en",
  "strings": {
    "Camera access is off. Turn it on in your phone's Settings app.": {
      "comment": "Watch warning: camera access for nope. is declined on the phone. Settings is the system app.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Kamerazugriff ist aus. Schalte ihn in der App „Einstellungen“ auf deinem Telefon ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso a la cámara está desactivado. Actívalo en la app Ajustes de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès à l’appareil photo est désactivé. Activez-le dans l’app Réglages de votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso alla fotocamera è disattivato. Attivalo nell’app Impostazioni del telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラへのアクセスがオフです。スマートフォンの設定アプリでオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라 접근이 꺼져 있습니다. 휴대폰의 설정 앱에서 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cameratoegang staat uit. Zet het aan in de Instellingen-app op je telefoon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acesso à câmera está desativado. Ative-o no app Ajustes do telefone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相机访问权限已关闭。请在手机的“设置”App 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相機取用權限已關閉。請在手機的「設定」App 中開啟。"
          }
        }
      }
    },
    "Camera not available. Open nope. on your phone.": {
      "comment": "Watch warning: the camera isn't running on the phone, for example because nope. isn't open there. Keep \"nope.\" unchanged.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamera nicht verfügbar. Öffne nope. auf deinem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cámara no disponible. Abre nope. en tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appareil photo indisponible. Ouvrez nope. sur votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fotocamera non disponibile. Apri nope. sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラを使用できません。スマートフォンでnope.を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라를 사용할 수 없습니다. 휴대폰에서 nope.를 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Camera niet beschikbaar. Open nope. op je telefoon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Câmera indisponível. Abra o nope. no telefone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相机不可用。请在手机上打开 nope.。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法使用相機。請在手機上開啟 nope.。"
          }
        }
      }
    },
