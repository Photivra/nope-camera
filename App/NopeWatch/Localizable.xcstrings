{
  "sourceLanguage" : "en",
  "strings" : {
    "Camera access is off. Turn it on in your phone's Settings app." : {
      "comment" : "Watch warning: camera access for nope. is declined on the phone. Settings is the system app."
    },
    "Camera not available. Open nope. on your phone." : {
      "comment" : "Watch warning: the camera isn't running on the phone, for example because nope. isn't open there. Keep \"nope.\" unchanged."
    },
    "Camera ready" : {
      "comment" : "Watch status: the phone's camera can take a photo."
    },
    "Can't reach your phone. Keep it nearby with nope. open." : {
      "comment" : "Watch warning: the paired phone can't be reached. Keep \"nope.\" unchanged."
    },
    "Cancel Timer" : {
      "comment" : "Watch button that stops the phone's self-timer countdown, so no photo is taken."
    },
    "Connecting to your phone…" : {
      "comment" : "Watch status while the watch app first reaches nope. on the phone."
    },
    "Delay" : {
      "comment" : "Watch picker: how long the phone waits before taking the photo."
    },
    "No photo taken." : {
      "comment" : "Watch result: nothing was taken because the phone's camera wasn't available; the status line says why."
    },
    "Not saved. Your phone shows why." : {
      "comment" : "Watch warning: the photo wasn't saved; the reason is on the phone's screen."
    },
    "Off" : {
      "comment" : "Watch delay picker: no delay before the photo."
    },
    "Open nope. on your phone to allow camera access." : {
      "comment" : "Watch warning: nope. on the phone hasn't asked for camera access yet. Keep \"nope.\" unchanged."
    },
    "Photo in %@" : {
      "comment" : "Watch status while the phone's self-timer counts down. The placeholder is a duration such as \"3 seconds\"."
    },
    "Photos saved and signed" : {
      "comment" : "Watch result: a bracket of photos was saved on the phone and every one is signed."
    },
    "Photos saved, not all signed" : {
      "comment" : "Watch warning: a bracket of photos was saved on the phone, but some aren't signed."
    },
    "Saved and signed" : {
      "comment" : "Watch result: the photo was saved to Photos on the phone and signed with Content Credentials."
    },
    "Saved, not signed" : {
      "comment" : "Watch warning: the photo was saved on the phone but isn't signed with Content Credentials."
    },
    "Take Photo" : {
      "comment" : "Watch button that takes a photo with the phone's camera."
    },
    "Taking photo…" : {
      "comment" : "Watch status: the phone is taking or saving a photo."
    },
    "The camera was busy. No photo taken." : {
      "comment" : "Watch result: the phone was already taking a photo, counting down or in a burst, so nothing was taken."
    },
    "Timer cancelled. No photo taken." : {
      "comment" : "Watch result: the self-timer was cancelled, so no photo was taken."
    },
    "Update nope. on your phone and watch." : {
      "comment" : "Watch warning: the phone and watch apps are different versions. Keep \"nope.\" unchanged."
    },
    "Your phone has no camera nope. can use." : {
      "comment" : "Watch warning: the phone has no usable camera. Keep \"nope.\" unchanged."
    }
  },
  "version" : "1.0"
}