    "Open nope. on your phone to allow camera access.": {
      "comment": "Watch warning: nope. on the phone hasn't asked for camera access yet. Keep \"nope.\" unchanged.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne nope. auf deinem Telefon, um den Kamerazugriff zu erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre nope. en tu teléfono para permitir el acceso a la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez nope. sur votre téléphone pour autoriser l’accès à l’appareil photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri nope. sul telefono per consentire l’accesso alla fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラへのアクセスを許可するには、スマートフォンでnope.を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라 접근을 허용하려면 휴대폰에서 nope.를 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open nope. op je telefoon om cameratoegang toe te staan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra o nope. no telefone para permitir o acesso à câmera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在手机上打开 nope. 以允许访问相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在手機上開啟 nope. 以允許取用相機。"
          }
        }
      }
    },
