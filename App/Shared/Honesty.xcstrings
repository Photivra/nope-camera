{
  "sourceLanguage": "en",
  "strings": {
    "Not every photo is signed. Open nope. for details.": {
      "comment": "Live Activity, after photos were saved and at least one has no Content Credentials signature; nope. says why. Honesty wording: never imply they are all signed. Keep \"nope.\" unchanged.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht alle Fotos sind signiert. Öffne nope. für Details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No todas las fotos están firmadas. Abre nope. para ver los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les photos ne sont pas toutes signées. Ouvrez nope. pour en savoir plus."
          }
        },
