    "A delay in seconds, up to a minute. It replaces the Delay choice.": {
      "comment": "Explains the Custom Delay setting of nope.'s Take Photo action. \"Delay\" is the name of the other setting.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Verzögerung in Sekunden, bis zu einer Minute. Sie ersetzt die Auswahl unter „Verzögerung“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un retardo en segundos, de hasta un minuto. Sustituye a la opción Retardo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un délai en secondes, jusqu’à une minute. Il remplace le choix Délai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un ritardo in secondi, fino a un minuto. Sostituisce la scelta Ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "秒単位の待ち時間（最大1分）。「待ち時間」の選択より優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초 단위 지연 시간(최대 1분). ‘지연’ 선택을 대신합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een vertraging in seconden, tot een minuut. Deze vervangt de keuze bij Vertraging."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um atraso em segundos, de até um minuto. Substitui a opção Atraso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以秒为单位的延迟，最长一分钟，会取代“延迟”的选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以秒為單位的延遲，最長一分鐘，會取代「延遲」的選擇。"
          }
        }
      }
    },
    "Camera access is off for nope. You can turn it on in the Settings app.": {
      "comment": "Siri's answer when camera access was declined. Keep \"nope.\" unchanged; Settings is the iOS app.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Kamerazugriff ist für nope. deaktiviert. Du kannst ihn in der App „Einstellungen“ aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso a la cámara está desactivado para nope. Puedes activarlo en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès à l’appareil photo est désactivé pour nope. Vous pouvez l’activer dans l’app Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso alla fotocamera è disattivato per nope. Puoi attivarlo nell’app Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope.のカメラへのアクセスはオフです。「設定」アプリでオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope.의 카메라 접근이 꺼져 있습니다. 설정 앱에서 켤 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cameratoegang staat uit voor nope. Je kunt deze aanzetten in de app Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acesso à câmera está desativado para o nope. Você pode ativá-lo no app Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. 的相机访问权限已关闭，你可以在“设置”App 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. 的相機取用權限已關閉，你可以在「設定」App 中開啟。"
          }
        }
      }
    },
