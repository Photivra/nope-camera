    "Interval shooting needs Manual Controls. Turn them on in nope. Settings.": {
      "comment": "Siri's answer when interval shooting was asked for while manual controls are off. \"Manual Controls\" is the option's name in Settings. Keep \"nope.\" unchanged.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für die Intervallaufnahme wird „Manuelle Steuerung“ benötigt. Schalte sie in den nope.-Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El disparo a intervalos requiere Controles manuales. Actívalos en los ajustes de nope."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La prise de vue par intervalles nécessite Commandes manuelles. Activez-les dans les réglages de nope."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo scatto a intervalli richiede Controlli manuali. Attivali nelle impostazioni di nope."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "インターバル撮影には「マニュアル操作」が必要です。nope. の設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인터벌 촬영에는 수동 조작이 필요합니다. nope. 설정에서 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voor intervalopnamen is Handmatige bediening nodig. Zet die aan in de instellingen van nope."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O disparo por intervalo precisa de Controles manuais. Ative-os nos ajustes do nope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "间隔拍摄需要“手动控制”。请在 nope. 设置中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "間隔拍攝需要「手動控制」。請在 nope. 設定中開啟。"
          }
        }
      }
    },
    "Interval shooting started.": {
