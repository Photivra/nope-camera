    "Turns nope.'s night mode on or off: every nope. screen in red on black.": {
      "comment": "Describes nope.'s Set Night Mode action in the Shortcuts app. Keep \"nope.\" unchanged.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schaltet den Nachtmodus von nope. ein oder aus: alle Bildschirme von nope. in Rot auf Schwarz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa o desactiva el modo nocturno de nope.: todas las pantallas de nope. en rojo sobre negro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Active ou désactive le mode nuit de nope. : tous les écrans de nope. en rouge sur noir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva o disattiva la modalità notte di nope.: tutte le schermate di nope. in rosso su nero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope.のナイトモードをオンまたはオフにします。オンにすると、nope.のすべての画面が黒地に赤で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope.의 야간 모드를 켜거나 끕니다. 켜면 nope.의 모든 화면이 검은 바탕에 빨간색으로 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zet de nachtmodus van nope. aan of uit: elk scherm van nope. in rood op zwart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ativa ou desativa o modo noturno do nope.: todas as telas do nope. em vermelho sobre preto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开或关闭 nope. 的夜间模式：nope. 的所有屏幕都以黑底红字显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
