{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld photos taken": {
      "comment": "Live Activity: interval shooting progress. Both numbers are counts of photos; the second is at least 2.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld von %2$lld Fotos aufgenommen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld de %2$lld fotos tomadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld photos prises sur %2$lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld di %2$lld foto scattate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld/%2$lld 枚撮影済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$lld장 중 %1$lld장 촬영됨"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld van %2$lld foto’s gemaakt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld de %2$lld fotos tiradas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已拍摄 %1$lld/%2$lld 张"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已拍攝 %1$lld/%2$lld 張"
          }
        }
      }
    },
