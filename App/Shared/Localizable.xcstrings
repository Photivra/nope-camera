    "Interval shooting stopped. The photos taken are saved.": {
      "comment": "Siri's answer after nope.'s interval series was stopped; the photos already taken are kept.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intervallaufnahme gestoppt. Die aufgenommenen Fotos sind gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disparo a intervalos detenido. Las fotos tomadas están guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prise de vue par intervalles arrêtée. Les photos prises sont enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scatto a intervalli interrotto. Le foto scattate sono salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "インターバル撮影を停止しました。撮影した写真は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인터벌 촬영을 중지했습니다. 찍은 사진은 저장되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intervalopnamen gestopt. De gemaakte foto’s zijn bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disparo por intervalo parado. As fotos tiradas estão salvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "间隔拍摄已停止。已拍摄的照片已存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "間隔拍攝已停止。已拍攝的照片已儲存。"
          }
        }
      }
    },
