    "A delay in seconds, up to a minute. It replaces the Delay choice.": {
      "comment": "Explains the Custom Delay setting of nope.'s Take Photo action. \"Delay\" is the name of the other setting.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Verzögerung in Sekunden, bis zu einer Minute. Sie ersetzt die Auswahl unter „Verzögerung“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un retardo en segundos, de hasta un minuto. Sustituye a la opción Retardo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un délai en secondes, jusqu’à une minute. Il remplace le choix Délai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un ritardo in secondi, fino a un minuto. Sostituisce la scelta Ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "秒単位の待ち時間（最大1分）。「待ち時間」の選択より優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초 단위 지연 시간(최대 1분). ‘지연’ 선택을 대신합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een vertraging in seconden, tot een minuut. Deze vervangt de keuze bij Vertraging."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um atraso em segundos, de até um minuto. Substitui a opção Atraso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以秒为单位的延迟，最长一分钟，会取代“延迟”的选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以秒為單位的延遲，最長一分鐘，會取代「延遲」的選擇。"
          }
        }
      }
    },
    "A photo wasn't saved. Open nope. for details.": {
      "comment": "Live Activity: a photo couldn't be taken or saved; nope. says why. Keep \"nope.\" unchanged.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Foto wurde nicht gesichert. Öffne nope. für Details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una foto no se guardó. Abre nope. para ver los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une photo n’a pas été enregistrée. Ouvrez nope. pour en savoir plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una foto non è stata salvata. Apri nope. per i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存されなかった写真があります。詳しくはnope.を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장되지 않은 사진이 있습니다. 자세한 내용은 nope.을 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een foto is niet bewaard. Open nope. voor details."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma foto não foi salva. Abra o nope. para ver os detalhes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有照片未存储。打开 nope. 查看详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有照片未儲存。打開 nope. 查看詳情。"
          }
        }
      }
    },
