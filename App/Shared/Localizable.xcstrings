    "Paused: %lld photos taken · %@ left. Open nope. to continue." : {
      "comment" : "Live Activity after the person left nope. during interval shooting that stops after a time: the series continues when nope. is opened again, and its time keeps running meanwhile. The number is a count of photos; the placeholder is the time left, such as 1:12:00, counted down by the system. Keep \"nope.\" unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paused: %#@photos@ · %2$@ left. Open nope. to continue."
          },
          "substitutions" : {
            "photos" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
