{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” applied, but some settings couldn't be applied as saved. Presets in nope. shows which, and can undo it." : {
      "comment" : "Siri's answer after nope. applied a saved settings preset but, for example, location access is off or the lens doesn't exist on this device. The placeholder is the preset's name, in the language's quotation marks. Keep \"nope.\" unchanged."
    },
    "“%@” applied. You can undo it in Presets." : {
      "comment" : "Siri's answer after nope. applied a saved settings preset. The placeholder is the preset's name, in the language's quotation marks. Presets is the name of the list in nope.'s Settings."
    },
    "%lld of %lld photos taken" : {
      "comment" : "Live Activity: interval shooting progress. Both numbers are counts of photos; the second is at least 2."
    },
    "1 Stop" : {
      "comment" : "A choice of the Step setting of nope.'s Take Bracket action: one stop (EV) between photos."
    },
    "1/3 Stop" : {
      "comment" : "A choice of the Step setting of nope.'s Take Bracket action: a third of a stop (EV) between photos."
    },
    "2 Stops" : {
      "comment" : "A choice of the Step setting of nope.'s Take Bracket action: two stops (EV) between photos."
    },
    "2/3 Stop" : {
      "comment" : "A choice of the Step setting of nope.'s Take Bracket action: two thirds of a stop (EV) between photos."
    },
    "3 Photos" : {
      "comment" : "A choice of the Frames setting of nope.'s Take Bracket action."
    },
    "3 Seconds" : {
      "comment" : "A choice of the Delay setting of nope.'s Take Photo action, also said to Siri."
    },
    "5 Photos" : {
      "comment" : "A choice of the Frames setting of nope.'s Take Bracket action."
    },
    "7 Photos" : {
      "comment" : "A choice of the Frames setting of nope.'s Take Bracket action."
    },
    "10 Seconds" : {
      "comment" : "A choice of the Delay setting of nope.'s Take Photo action, also said to Siri."
    },
    "A delay in seconds, up to a minute. It replaces the Delay choice." : {
      "comment" : "Explains the Custom Delay setting of nope.'s Take Photo action. \"Delay\" is the name of the other setting."
    },
    "A photo wasn't saved. Open nope. for details." : {
      "comment" : "Live Activity: a photo couldn't be taken or saved; nope. says why. Keep \"nope.\" unchanged."
    },
    "Apply ${preset}" : {
      "comment" : "How nope.'s Apply Preset action reads in the Shortcuts editor. ${preset} is a preset's name, such as \"Factory Defaults\". Keep ${preset} unchanged."
    },
    "Apply Preset" : {
      "comment" : "The name of nope.'s action that applies a settings preset (Factory Defaults or one the person saved), in the Shortcuts app."
    },
    "Astro" : {
      "comment" : "Title on nope.'s Live Activity: the night sky helper, which takes a series of single RAW frames."
    },
    "Astro is on. Turn it off to start interval shooting." : {
      "comment" : "Siri's answer when interval shooting was asked for while nope.'s night sky helper is on. Astro is the helper's name on the camera."
    },
    "Autofocus has no range limit." : {
      "comment" : "Siri's answer after nope.'s autofocus range limit (Close-Up or Far Focus) was lifted."
    },
    "Burst" : {
      "comment" : "Title on nope.'s Live Activity: a rapid run of single photos."
    },
    "Camera access is off for nope. You can turn it on in the Settings app." : {
      "comment" : "Siri's answer when camera access was declined. Keep \"nope.\" unchanged; Settings is the iOS app."
    },
    "Chooses how fast a shutter nope. prefers while Manual Controls are off, to avoid blur." : {
      "comment" : "Describes nope.'s Set Fast Shutter action in the Shortcuts app. Keep \"nope.\" unchanged. Manual Controls is the name of nope.'s button; use its translation. Must not claim more than the English."
    },
    "Close-Up" : {
      "comment" : "Quick control and pill on the camera: limits autofocus to near subjects, for small things close to the lens."
    },
    "Close-Up is on." : {
      "comment" : "Siri's answer after nope. limited autofocus to near subjects. Close-Up is the camera control's name."
    },
    "Custom Delay" : {
      "comment" : "A setting of nope.'s Take Photo action: a delay in seconds that you type."
    },
    "Delay" : {
      "comment" : "A setting of nope.'s Take Photo action: how long to wait before the photo."
    },
    "Done: %lld of %lld photos taken" : {
      "comment" : "Live Activity: interval shooting finished. Both numbers are counts of photos."
    },
    "Every photo already taken is saved." : {
      "comment" : "VoiceOver hint of the Stop button on nope.'s Live Activity."
    },
    "Factory Defaults" : {
      "comment" : "Built-in settings preset that returns every setting to what a fresh install has."
    },
    "Factory Defaults applied, but some settings couldn't be applied as saved. Presets in nope. shows which, and can undo it." : {
      "comment" : "Siri's answer after nope. applied Factory Defaults but, for example, the camera wasn't on. Presets is the name of the list in nope.'s Settings. Keep \"nope.\" unchanged."
    },
    "Factory Defaults applied. You can undo it in Presets." : {
      "comment" : "Siri's answer after nope. returned every setting to a fresh install's. Presets is the name of the list in nope.'s Settings."
    },
    "Far Focus" : {
      "comment" : "Quick control and pill on the camera: limits autofocus to far subjects, such as a landscape seen past near branches."
    },
    "Far Focus is on." : {
      "comment" : "Siri's answer after nope. limited autofocus to far subjects. Far Focus is the camera control's name."
    },
    "Fast Shutter" : {
      "comment" : "Setting and quick control: how fast a shutter full auto prefers, to avoid blur."
    },
    "Fast Shutter is set." : {
      "comment" : "Siri's answer after nope.'s Fast Shutter setting was changed."
    },
    "Fast shutter: Standard" : {
      "comment" : "Fast shutter choice: full auto aims for a shutter fast enough to hold by hand. The default.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard"
          }
        }
      }
    },
    "First frame in %@" : {
      "comment" : "Live Activity: the countdown before the night sky helper's first frame. The placeholder is the time left, such as 0:07, counted down by the system."
    },
    "Focus on Faces" : {
      "comment" : "Switch: faces the camera detects steer autofocus and auto exposure."
    },
    "Focus on Faces is off." : {
      "comment" : "Siri's answer after nope.'s Focus on Faces was turned off."
    },
    "Focus on Faces is on." : {
      "comment" : "Siri's answer after nope.'s Focus on Faces was turned on."
    },
    "Focus Range" : {
      "comment" : "A setting of nope.'s Set Focus Range action: which subjects autofocus looks for."
    },
    "Frame %lld of %lld" : {
      "comment" : "Live Activity: which frame of the night sky helper's series is being taken, of how many."
    },
    "Frames" : {
      "comment" : "A setting of nope.'s Take Bracket action: how many photos the bracket takes."
    },
    "Freeze Fast Motion (1/1000 s)" : {
      "comment" : "Fast shutter choice: full auto keeps the shutter at 1/1000 second or faster. Keep the fraction."
    },
    "Freeze Motion (1/500 s)" : {
      "comment" : "Fast shutter choice: full auto keeps the shutter at 1/500 second or faster. Keep the fraction."
    },
    "Front" : {
      "comment" : "The front (selfie) camera, as a lens choice."
    },
    "Interval Shooting" : {
      "comment" : "Title on nope.'s Live Activity: a series of photos taken at a fixed interval."
    },
    "Interval shooting started." : {
      "comment" : "Siri's answer after nope. started a series of photos at a fixed interval."
    },
    "Interval shooting stopped. The photos taken are saved." : {
      "comment" : "Siri's answer after nope.'s interval series was stopped; the photos already taken are kept."
    },
    "Largest" : {
      "comment" : "A choice of nope.'s Set Photo Size action: the largest photo size the lens offers."
    },
    "Lens" : {
      "comment" : "A setting of nope.'s Take Photo action: which camera to use."
    },
    "More than one takes a burst: separate photos, as fast as the camera allows, up to 50." : {
      "comment" : "Explains the Number of Photos setting of nope.'s Take Photo action."
    },
    "Night Mode" : {
      "comment" : "The setting of nope.'s Set Night Mode action: on or off."
    },
    "Night mode is off." : {
      "comment" : "Siri's answer after nope.'s night mode was turned off."
    },
    "Night mode is on." : {
      "comment" : "Siri's answer after nope.'s night mode was turned on."
    },
    "Night Mode Off" : {
      "comment" : "The name of the shortcut that turns nope.'s night mode off, in the Shortcuts app."
    },
    "Night Mode On" : {
      "comment" : "The name of the shortcut that turns nope.'s night mode on, in the Shortcuts app."
    },
    "No Delay" : {
      "comment" : "A choice of the Delay setting of nope.'s Take Photo action: take the photo at once."
    },
    "No interval series is running." : {
      "comment" : "Siri's answer when asked to stop interval shooting while none runs."
    },
    "No Limit" : {
      "comment" : "A choice of nope.'s Set Focus Range action: autofocus searches near and far."
    },
    "nope. is already taking a photo." : {
      "comment" : "Siri's answer when a photo, countdown or burst is already running. Keep \"nope.\" unchanged."
    },
    "nope. is busy. The lens didn't change." : {
      "comment" : "Siri's answer when Switch Lens is asked for while nope. is taking a photo, a countdown, burst, interval series or astro run is running, or the compare view is open; the lens stays as it was. Keep \"nope.\" unchanged."
    },
    "nope. is still doing an earlier request. Nothing changed." : {
      "comment" : "Siri's answer when the request waited too long behind an earlier Siri, Shortcuts or Apple Watch request that nope. was still doing. Keep \"nope.\" unchanged."
    },
    "Now using the front camera." : {
      "comment" : "Siri's answer after nope. switched to the front (selfie) camera."
    },
