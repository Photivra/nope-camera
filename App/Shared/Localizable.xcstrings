    },
    "Opens nope. and turns on the steady light. It turns off when nope. closes." : {
      "comment" : "Describes nope.'s Turn On the Light action in the Shortcuts app. The light is the torch beside the camera. Keep \"nope.\" unchanged."
    },
    "Opens the nope. camera." : {
      "comment" : "Describes what nope.'s Open the Camera action and control do, in the Shortcuts app and the controls gallery. Keep \"nope.\" unchanged."
    },
    "Paused: %lld of %lld frames. Open nope. to continue." : {
      "comment" : "Live Activity after the person left nope. during the night sky helper's frames, or the camera paused them: the run continues when nope. is open again, after its start delay. Both numbers are counts of frames. Keep \"nope.\" unchanged."
    },
    "Paused: %lld of %lld photos taken. Open nope. to continue." : {
