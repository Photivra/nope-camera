{
  "sourceLanguage" : "en",
  "strings" : {
    "Open the camera in ${applicationName}" : {
      "comment" : "A Siri phrase that opens nope.'s camera. ${applicationName} is the app's name, nope. Keep ${applicationName} unchanged.",
      "extractionState" : "manual"
    },
    "Start interval shooting in ${applicationName}" : {
