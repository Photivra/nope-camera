  "strings": {
    "Take a photo in ${delay} with ${applicationName}": {
      "comment": "A Siri phrase that takes a photo after a delay. ${delay} is \"3 Seconds\" or \"10 Seconds\"; ${applicationName} is the app's name, nope. Keep both placeholders unchanged.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringSet": {
            "state": "needs_review",
            "values": [
