# Pinned inputs for the network-free C2PA library (scripts/build-c2pa-lib.sh, c2pa-lib/README.md).
# Change only in a reviewed pull request; the published xcframework's checksum changes with them.

# c2pa-rs source: the release tag and the exact commit it points to.
C2PA_RS_REPOSITORY=https://github.com/contentauth/c2pa-rs.git
C2PA_RS_TAG=c2pa-v0.92.0
C2PA_RS_COMMIT=83eba34d1a0b6be4d2484fc5d7b4cf11c030b694

# Cargo features of c2pa-c-ffi: Rust-native cryptography and file I/O only. Not enabled:
# http (reqwest, rustls), add_thumbnails, openssl. c2pa_c_ffi.patch also removes
# c2pa/fetch_remote_manifests.
C2PA_FEATURES=rust_native_crypto,file_io

# Apple targets: iPhone and iPad devices, and the Simulator on Apple silicon and Intel Macs.
C2PA_TARGETS="aarch64-apple-ios aarch64-apple-ios-sim x86_64-apple-ios"

# Matches c2pa-rs's own release Makefile (c2pa_c_ffi/Makefile).
IPHONEOS_DEPLOYMENT_TARGET=15.0

# Release tag in this repository for the published xcframework (separate from the app's v* tags).
C2PA_LIB_TAG=c2pa-lib-v0.92.0
