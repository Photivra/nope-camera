    "Search Settings" : {
      "comment" : "VoiceOver and Voice Control name of the search field on the Settings screen in Night Mode (issue #88).",
      "extractionState" : "manual"
    },
    "Show Hidden Values" : {
      "comment" : "Button at the top of a group on the Every Tag page of the photo details: shows the group's identifying values, such as the location, until the sheet closes.",
      "extractionState" : "manual"
    },
    "Show Location" : {
      "comment" : "Voice Control name of the Show Value button of the location in the photo details.",
