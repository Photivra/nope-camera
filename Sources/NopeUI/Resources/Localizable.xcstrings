          }
        }
      }
    },
    "The camera isn't on, so the lens and camera values didn't change.": {
      "comment": "Shown after applying a settings preset before the camera is allowed or started.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera ist nicht eingeschaltet, daher wurden Objektiv und Kamerawerte nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cámara no está activa, así que el objetivo y los valores de la cámara no han cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo n’est pas actif ; l’objectif et les valeurs de l’appareil photo n’ont donc pas changé."
          }
        },
        "it": {
          "stringUnit": {
