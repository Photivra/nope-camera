    "10-bit keeps smoother gradients. 8-bit files are smaller.": {
      "comment": "Explains the HEIF bit depth picker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10 Bit erhält weichere Verläufe. 8-Bit-Dateien sind kleiner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10 bits conserva degradados más suaves. Los archivos de 8 bits son más pequeños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le 10 bits conserve des dégradés plus doux. Les fichiers 8 bits sont plus petits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10 bit mantiene sfumature più morbide. I file a 8 bit sono più piccoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10ビットはグラデーションがより滑らかです。8ビットはファイルが小さくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10비트는 그라데이션이 더 부드럽습니다. 8비트 파일은 더 작습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10-bits behoudt vloeiendere overgangen. 8-bits bestanden zijn kleiner."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10 bits mantém gradientes mais suaves. Arquivos de 8 bits são menores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10 位的渐变更平滑。8 位文件更小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10 位元的漸層更平滑。8 位元檔案更小。"
          }
        }
      }
    },
