          }
        }
      }
    },
    "No photo was taken: the camera is paused.": {
      "comment": "Shown when the shutter is pressed while the camera is paused.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es wurde kein Foto aufgenommen: Die Kamera ist pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se tomó ninguna foto: la cámara está en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune photo n’a été prise : l’appareil photo est en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna foto scattata: la fotocamera è in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写真は撮影されませんでした：カメラが一時停止中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진이 찍히지 않았습니다. 카메라가 일시 정지 상태입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is geen foto gemaakt: de camera is gepauzeerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma foto foi tirada: a câmera está pausada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未拍摄照片：相机已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未拍攝照片：相機已暫停。"
          }
        }
      }
    },
    "No photo was taken: the camera sent a blank picture.": {
      "comment": "Shown when the camera delivered a completely blank picture, so the app discarded it.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es wurde kein Foto aufgenommen: Die Kamera hat ein leeres Bild geliefert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se tomó ninguna foto: la cámara envió una imagen vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune photo n’a été prise : l’appareil photo a envoyé une image vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna foto scattata: la fotocamera ha inviato un’immagine vuota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写真は撮影されませんでした：カメラから空の画像が届きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진을 찍지 않았습니다. 카메라가 빈 화면을 보냈습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is geen foto gemaakt: de camera stuurde een leeg beeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma foto foi tirada: a câmera enviou uma imagem em branco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未拍摄照片：相机传送了空白画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未拍攝照片：相機傳送了空白畫面。"
          }
        }
      }
    },
    "Not saved: nope. isn't allowed to add photos. You can allow it in the Settings app.": {
      "comment": "Shown when the person hasn't allowed the app to add photos to their photo library. Keep the name nope. unchanged, lowercase with its period.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht gesichert: nope. darf keine Fotos hinzufügen. Du kannst es in der App „Einstellungen“ erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se guardó: nope. no tiene permiso para añadir fotos. Puedes permitirlo en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non enregistrée : nope. n’est pas autorisé à ajouter des photos. Vous pouvez l’autoriser dans l’app Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non salvata: nope. non ha il permesso di aggiungere foto. Puoi consentirlo nell’app Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存されませんでした：nope. には写真を追加する許可がありません。「設定」アプリで許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장되지 않음: nope.에 사진 추가 권한이 없습니다. 설정 앱에서 허용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niet bewaard: nope. mag geen foto’s toevoegen. Je kunt dit toestaan in de app Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não salva: nope. não tem permissão para adicionar fotos. Você pode permitir no app Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未存储：nope. 没有添加照片的权限。你可以在“设置”App 中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未儲存：nope. 沒有加入照片的權限。你可以在「設定」App 中允許。"
          }
        }
      }
    },
    "Not saved: the photo couldn't be developed. Try again.": {
      "comment": "Shown when the app couldn't turn the RAW photo into a HEIF or JPEG file, so nothing was saved. HEIF and JPEG are not mentioned to keep it short.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht gesichert: Das Foto konnte nicht entwickelt werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se guardó: no se pudo revelar la foto. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non enregistrée : la photo n’a pas pu être développée. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non salvata: non è stato possibile sviluppare la foto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存されませんでした：写真を現像できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장되지 않음: 사진을 현상할 수 없었습니다. 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niet bewaard: de foto kon niet worden ontwikkeld. Probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não salva: não foi possível revelar a foto. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未存储：无法冲洗照片。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未儲存：無法沖洗照片。請再試一次。"
          }
        }
      }
    },
    "Not saved: the photo library couldn't add the photo. Try again.": {
      "comment": "Shown when the system photo library reported an error while adding the photo.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht gesichert: Die Fotomediathek konnte das Foto nicht hinzufügen. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se guardó: la fototeca no pudo añadir la foto. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non enregistrée : la photothèque n’a pas pu ajouter la photo. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non salvata: la libreria foto non è riuscita ad aggiungere la foto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存されませんでした：写真ライブラリに写真を追加できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장되지 않음: 사진 보관함에 사진을 추가할 수 없었습니다. 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niet bewaard: de fotobibliotheek kon de foto niet toevoegen. Probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não salva: a fototeca não conseguiu adicionar a foto. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未存储：照片图库无法添加照片。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未儲存：照片圖庫無法加入照片。請再試一次。"
          }
        }
      }
    },
    "Not saved: this version of the app can't save photos.": {
      "comment": "Shown when this build of the app has no way to save photos, for example in a preview.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht gesichert: Diese Version der App kann keine Fotos sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se guardó: esta versión de la app no puede guardar fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non enregistrée : cette version de l’app ne peut pas enregistrer de photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non salvata: questa versione dell’app non può salvare foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存されませんでした：このバージョンのアプリでは写真を保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장되지 않음: 이 버전의 앱은 사진을 저장할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niet bewaard: deze versie van de app kan geen foto’s bewaren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não salva: esta versão do app não pode salvar fotos."
          }
