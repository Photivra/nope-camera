{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ a second" : {
      "comment" : "Burst card on the camera: the rate measured from the photos of this burst, in photos a second, such as 2.6. The value is a number with one decimal place, formatted by the system. It is a measurement, not a promise.",
      "extractionState" : "manual"
    },
    "%@ · after %@" : {
      "comment" : "Bracket card on the camera, second line, with a start delay: the frames' exposure offsets, such as \"−1, 0, +1 EV\", then the delay, such as \"3 seconds\", formatted by the system.",
      "extractionState" : "manual"
    },
    "%@, not %@" : {
      "comment" : "A frame in Bracket Settings that the lens can't give: the exposure offset it will have, such as \"+2 EV\", then the one asked for, such as \"+4\".",
      "extractionState" : "manual"
    },
    "%lld frames were not at their planned focus" : {
      "comment" : "Focus bracket card after the series: how many frames the lens reported at a focus position other than the one planned. The frames are saved.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld frame was not at its planned focus"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld frames were not at their planned focus"
                }
              }
            }
          }
        }
      }
    },
    "%lld frames, %@" : {
      "comment" : "Bracket card on the camera while the start delay counts down, second line: the number of frames, then their exposure offsets, such as \"−1, 0, +1 EV\".",
      "extractionState" : "manual"
    },
    "%lld frames, focus %@ to %@" : {
      "comment" : "Focus bracket card while the start delay counts down, second line: the number of frames and the focus positions, on the lens's own scale from 0 to 1.",
      "extractionState" : "manual"
    },
    "%lld of %lld" : {
      "comment" : "Caption in the Last Photo viewer: the position of the photo shown among the photos taken since nope. opened, such as 3 of 5. Shown only when there is more than one photo.",
      "extractionState" : "manual"
    },
    "%lld photos saved" : {
      "comment" : "Card on the camera after an exposure bracket or a burst: how many separate photos were saved to the photo library.",
      "extractionState" : "manual"
    },
    "App Store" : {
      "comment" : "Section header on the About screen above the Rate or Review row. App Store is Apple's name; use its name in the language's iOS.",
      "extractionState" : "manual"
    },
    "As fast as the camera is ready" : {
      "comment" : "Detail of the Fast burst speed in the Burst menu. It makes no claim about a rate.",
      "extractionState" : "manual"
    },
    "Battery at %@. Charge the device soon to keep taking photos. Keep Screen On is not used now." : {
      "comment" : "Explanation of the Battery Low warning on the camera while the Keep Screen On switch is on: the screen may lock by itself again until the battery is charged. The value is the battery charge as a percentage, such as 3%, formatted by the system. Keep Screen On is the name of nope.'s switch. Draft wording for the Honesty review (issue #97).",
      "extractionState" : "manual"
    },
    "Battery at %@. Low Power Mode is on. Keep Screen On is not used now." : {
      "comment" : "Explanation of the Battery Low warning on the camera while Low Power Mode is on and the Keep Screen On switch is on: the screen may lock by itself again until the battery is charged. The value is the battery charge as a percentage, such as 3%, formatted by the system. Low Power Mode is Apple's name for the iPhone and iPad setting; Keep Screen On is the name of nope.'s switch. Draft wording for the Honesty review (issue #97).",
      "extractionState" : "manual"
    },
    "Bracket card: Cancel" : {
      "comment" : "Button on the bracket card while the start delay counts down: stops the countdown; no photo is taken.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "Bracket details: Exposure" : {
      "comment" : "Value of the Type row in the photo details: an exposure bracket, frames at different exposures.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposure"
          }
        }
      }
    },
    "Bracket details: Focus" : {
      "comment" : "Row in the photo details of a focus bracket's frame: the focus position the lens reported, from 0 to 1.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus"
          }
        }
      }
    },
    "Bracket details: Type" : {
      "comment" : "Row in the photo details of a bracket's frame: the kind of bracket.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type"
          }
        }
      }
    },
    "Bracket in %@" : {
      "comment" : "Bracket card on the camera while the start delay counts down: the bracket is taken after this many seconds. The value is a short number of seconds, such as 3s, formatted by the system.",
      "extractionState" : "manual"
    },
    "Bracket Settings" : {
      "comment" : "Title of the sheet with the exposure bracket's frames, step, order and start delay, and the name of the card on the camera that opens it.",
      "extractionState" : "manual"
    },
    "Bracket Settings: Type" : {
      "comment" : "Control in Bracket Settings: the kind of bracket, exposure or focus.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type"
          }
        }
      }
    },
    "Bracket stopped: %lld of %lld photos saved." : {
      "comment" : "Banner on the camera when a frame of an exposure bracket couldn't be saved; the reason follows in another sentence. The first number is the photos saved, the second the frames in the bracket.",
      "extractionState" : "manual"
    },
    "Bracket type: Exposure" : {
      "comment" : "Choice of the Type control in Bracket Settings, and of the Take Bracket action: frames at different exposures.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposure"
          }
        }
      }
    },
    "Bracket type: Focus" : {
      "comment" : "Choice of the Type control in Bracket Settings, and of the Take Bracket action: frames at different focus positions.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus"
          }
        }
      }
    },
    "Bracket, exposure, %lld frames" : {
      "comment" : "VoiceOver value of the shutter when one press takes an exposure bracket. The number is the count of frames.",
      "extractionState" : "manual"
    },
    "Bracket, focus, %lld frames" : {
      "comment" : "VoiceOver value of the shutter when one press takes a focus bracket. The number is the count of frames.",
      "extractionState" : "manual"
    },
    "Brightest First" : {
      "comment" : "Choice of the bracket's Order: the brightest frame first, then darker ones.",
      "extractionState" : "manual"
    },
    "Burst Speed" : {
      "comment" : "Title of the menu of the selected Burst word on the camera: how fast a burst takes its photos.",
      "extractionState" : "manual"
    },
    "Burst speed: Fast" : {
      "comment" : "Burst speed in the menu of the selected Burst word: photos are taken as fast as the camera is ready.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast"
          }
        }
      }
    },
    "Burst speed: Slow" : {
      "comment" : "Burst speed in the menu of the selected Burst word: up to 2 photos a second.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow"
          }
        }
      }
    },
    "Burst, fast." : {
      "comment" : "VoiceOver value of the shutter in burst mode at the Fast speed: photos are taken as fast as the camera is ready while the shutter is held.",
      "extractionState" : "manual"
    },
    "Burst, slow." : {
      "comment" : "VoiceOver value of the shutter in burst mode at the Slow speed: up to 2 photos a second while the shutter is held.",
      "extractionState" : "manual"
    },
    "Cancel" : {
      "comment" : "Button beside the Night Mode search field: ends the search and closes the keyboard. Use the word iOS shows beside its own search fields (issue #88).",
      "extractionState" : "manual"
    },
    "Clear text" : {
      "comment" : "VoiceOver and Voice Control name of the button in the Night Mode search field that empties it. Use the name iOS gives the same button in its search fields (issue #88).",
      "extractionState" : "manual"
    },
    "Close" : {
      "comment" : "Button in the Last Photo viewer that closes the viewer and returns to the camera. Drawn as an X where Last Photo is.",
      "extractionState" : "manual"
    },
    "Closest" : {
      "comment" : "Label under the leading end of the focus bracket's track: the closest the lens focuses (position 0).",
      "extractionState" : "manual"
    },
    "Continues when the camera is back" : {
      "comment" : "Focus bracket card while the series is paused: it goes on when the app is open and the camera runs again.",
      "extractionState" : "manual"
    },
    "Darkest First" : {
      "comment" : "Choice of the bracket's Order: the darkest frame first, then brighter ones.",
      "extractionState" : "manual"
    },
    "Double tap for one photo. Double tap and hold for a burst." : {
      "comment" : "VoiceOver hint of the shutter in burst mode: a double tap takes one photo; a double tap and hold takes photos until the finger lifts.",
      "extractionState" : "manual"
    },
    "Drive strip: Bracket" : {
      "comment" : "Drive mode word in the strip above the shutter: one press takes an exposure bracket, several separate photos at different exposures. A short word; the strip holds six.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bracket"
          }
        }
      }
    },
    "Exposure and white balance are locked at the first frame, so every frame matches." : {
      "comment" : "Footer in Bracket Settings for a focus bracket.",
      "extractionState" : "manual"
    },
    "Exposure bracket · frame %lld of %lld · %@" : {
      "comment" : "Chip on a photo in the Last Photo viewer: the photo is one frame of an exposure bracket. The numbers are the frame and the count of frames; the last value is the frame's exposure offset, such as \"0 EV\".",
      "extractionState" : "manual"
    },
    "Exposure bracket, frame %lld of %lld, %@." : {
      "comment" : "VoiceOver, part of a photo's label in the Last Photo viewer: the photo is one frame of an exposure bracket. The numbers are the frame and the count of frames; the last value is its exposure offset, such as \"0 EV\".",
      "extractionState" : "manual"
    },
    "Exposure bracket: %lld frames, %@ apart" : {
      "comment" : "Bracket card on the camera: what one press of the shutter takes. The number is the count of frames (3, 5 or 7); the second value is the step between them, such as \"1 EV\".",
      "extractionState" : "manual"
    },
    "Farthest First" : {
      "comment" : "Choice of the focus bracket's Order: the farthest focus first.",
      "extractionState" : "manual"
    },
    "Farthest Focus" : {
      "comment" : "Row in Bracket Settings, button on the focus bracket card and title of the dial: the farthest focus position of a focus bracket.",
      "extractionState" : "manual"
    },
    "Farthest: %@" : {
      "comment" : "Button on the focus bracket card: sets the farthest focus position on the picture. The value is a position from 0 to 1.",
      "extractionState" : "manual"
    },
    "Fast burst" : {
      "comment" : "Burst card on the camera, before a burst: the speed in use. Photos are taken as fast as the camera is ready.",
      "extractionState" : "manual"
    },
    "Focus %@" : {
      "comment" : "Focus bracket card while it runs: the focus position the lens reports, on its own scale from 0 to 1, not a distance.",
      "extractionState" : "manual"
    },
    "Focus %@ to %@, farthest first" : {
      "comment" : "Focus bracket card, second line: the focus positions on the lens's own scale from 0 to 1, not distances, and the order.",
      "extractionState" : "manual"
    },
    "Focus %@ to %@, nearest first" : {
      "comment" : "Focus bracket card, second line: the focus positions on the lens's own scale from 0 to 1, not distances, and the order.",
      "extractionState" : "manual"
    },
    "Focus bracket stopped: %lld of %lld photos saved" : {
      "comment" : "Focus bracket card when the series ended before its last frame. The first number is the photos saved, the second the frames in the bracket.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bracket stopped: %lld of %lld photos saved"
          }
        }
      }
    },
    "Focus bracket · frame %lld of %lld · focus %@" : {
      "comment" : "Chip on a photo in the Last Photo viewer: the photo is one frame of a focus bracket. The numbers are the frame and the count of frames; the last value is the focus position the lens reported, from 0 to 1.",
      "extractionState" : "manual"
    },
    "Focus bracket, frame %lld of %lld, focus %@." : {
      "comment" : "VoiceOver, part of a photo's label in the Last Photo viewer: the photo is one frame of a focus bracket. The numbers are the frame and the count of frames; the last value is the focus position the lens reported, from 0 to 1.",
      "extractionState" : "manual"
    },
    "Focus bracket: %lld frames" : {
      "comment" : "Focus bracket card on the camera: what one press of the shutter takes. The number is the count of frames.",
      "extractionState" : "manual"
    },
    "Focus bracketing needs a lens whose focus can be set. This lens’s focus can’t." : {
      "comment" : "Under the Type control in Bracket Settings, on a lens whose focus can't be set by the app.",
      "extractionState" : "manual"
    },
    "Focus dial: Cancel" : {
      "comment" : "Button on the focus dial: leaves the focus bracket's range as it was.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "Focus is back to %@" : {
      "comment" : "Focus bracket card after the series: focus is back at the position set by hand before, from 0 to 1.",
      "extractionState" : "manual"
    },
    "Focus is back to Auto" : {
      "comment" : "Focus bracket card after the series: focus is automatic again.",
      "extractionState" : "manual"
    },
    "Focus Range" : {
      "comment" : "Section header in Bracket Settings: the nearest and farthest focus of a focus bracket.",
      "extractionState" : "manual"
    },
    "Focus stays at %@" : {
      "comment" : "Focus bracket card after the series: focus stays at the last frame's position, from 0 to 1.",
      "extractionState" : "manual"
    },
    "Focus Step" : {
      "comment" : "Row in Bracket Settings: the difference between neighboring frames of a focus bracket, on the lens's own scale from 0 to 1.",
      "extractionState" : "manual"
    },
    "Frame %lld, %@, %@, ISO %@" : {
      "comment" : "VoiceOver label of a frame in Bracket Settings: the frame's number, its exposure offset such as \"-1 EV\", its shutter speed such as \"1/250\", and its ISO.",
      "extractionState" : "manual"
    },
    "From the exposure the camera reads now; it is read again when you press the shutter. ISO changes from frame to frame. The shutter speed changes only where ISO can't go further." : {
      "comment" : "Footer under The Frames in Bracket Settings when the shutter speed is set by hand: the frames are planned from the camera's current reading, and ISO changes first.",
      "extractionState" : "manual"
    },
    "From the exposure the camera reads now; it is read again when you press the shutter. The shutter speed changes from frame to frame. ISO changes only where the shutter can't go further." : {
      "comment" : "Footer under The Frames in Bracket Settings: the frames are planned from the camera's current reading, and the shutter speed changes first.",
      "extractionState" : "manual"
    },
    "Hold the shutter. A tap takes one photo." : {
      "comment" : "Burst card on the camera, before a burst: what the shutter does in burst mode.",
      "extractionState" : "manual"
    },
    "Keep Screen On" : {
      "comment" : "Switch and its Voice Control name: while the camera is showing, the screen doesn't lock by itself for up to 30 minutes after the last touch or photo. Draft wording for the Honesty review (issue #97).",
      "extractionState" : "manual"
    },
    "Metered First" : {
      "comment" : "Choice of the bracket's Order: the frame at the metered exposure first, then darker and brighter ones, outward.",
      "extractionState" : "manual"
    },
    "Nearest First" : {
      "comment" : "Choice of the focus bracket's Order: the nearest focus first.",
      "extractionState" : "manual"
    },
    "Nearest Focus" : {
      "comment" : "Row in Bracket Settings, button on the focus bracket card and title of the dial: the nearest focus position of a focus bracket.",
      "extractionState" : "manual"
    },
    "Nearest: %@" : {
      "comment" : "Button on the focus bracket card: sets the nearest focus position on the picture. The value is a position from 0 to 1.",
      "extractionState" : "manual"
    },
    "New Photo" : {
      "comment" : "Button in the Last Photo viewer that goes to a photo taken while the viewer was open, for example from Apple Watch or Siri.",
      "extractionState" : "manual"
    },
    "Night Mode doesn't change the screen's brightness. Dim it in Control Center, or with Reduce White Point in the Accessibility settings." : {
      "comment" : "Accessibility screen, Night Mode: how to dim the screen. Night Mode is the name of nope.'s switch; use its translation. Control Center and Reduce White Point are names of iOS features: use their names in the language's iOS. Draft wording for the Honesty review (issue #97).",
      "extractionState" : "manual"
    },
    "No photos were taken: the camera wasn't ready for the bracket. Try again." : {
      "comment" : "Shown when the shutter was pressed with an exposure bracket on, but the camera had not yet measured the exposure the bracket's photos are planned around (for example just after switching lenses), so nothing was taken.",
      "extractionState" : "manual"
    },
    "Opens Bracket Settings." : {
      "comment" : "VoiceOver hint on the selected Bracket word of the drive strip above the shutter: activating it again opens Bracket Settings.",
      "extractionState" : "manual"
    },
    "Opens the App Store." : {
      "comment" : "VoiceOver hint of the Rate or Review row on the About screen: tapping it leaves the app for the App Store. App Store is Apple's name; use its name in the language's iOS.",
      "extractionState" : "manual"
    },
    "Opens the App Store. Ratings and reviews there are public." : {
      "comment" : "Footer under the Rate or Review row on the About screen: the row leaves the app, and anything written there can be read by anyone. App Store is Apple's name; use its name in the language's iOS.",
      "extractionState" : "manual"
    },
    "Order" : {
      "comment" : "Picker in Bracket Settings, and a setting of the Take Bracket action: the order in which the frames are taken.",
      "extractionState" : "manual"
    },
    "Photo Format sheet: Formats for Other Lenses" : {
      "comment" : "Button on the Photo Format sheet of a lens that can't save RAW: closes the sheet and opens Settings at Formats, where the formats of the other lenses are chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formats for Other Lenses"
          }
        }
      }
    },
    "Photo Format sheet: This Lens Saves" : {
      "comment" : "Section header on the Photo Format sheet of a lens that can't save RAW, above the one file format that lens saves (for example HEIF). The list can't be changed there.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Lens Saves"
          }
        }
      }
    },
    "%@ at %@" : {
      "comment" : "In the photo details: the DNG default crop, its size then its origin, such as 4032 × 3024 at 0, 0.",
      "extractionState" : "manual"
    },
    "%@ MP" : {
      "comment" : "In the photo details, under a size in pixels: the number of megapixels, such as 12 MP. MP means megapixels.",
      "extractionState" : "manual"
    },
    "%@ · %@" : {
      "comment" : "Every Tag page of the photo details: a tag's number, then the setting that controls it, such as 0x829A · Exposure Settings. Keep the separator.",
      "extractionState" : "manual"
    },
    "%@ · %lld-bit" : {
      "comment" : "In the photo details, under a file: its pixels and bit depth, such as 4032 × 3024 pixels · 10-bit.",
      "extractionState" : "manual"
    },
    "%@ · %lld-bit · %@ · %@" : {
      "comment" : "In the photo details, under a HEIF or JPEG copy: its pixels, bit depth, color space and compression quality, such as 4032 × 3024 pixels · 10-bit · Display P3 · High Quality. The last placeholder is the name of the compression choice in Settings.",
      "extractionState" : "manual"
    },
    "%@ · %lld-bit · lossless" : {
      "comment" : "In the photo details, under a RAW file: its pixels, bit depth and that its compression is lossless, such as 4032 × 3024 pixels · 12-bit · lossless.",
      "extractionState" : "manual"
    },
    "%@, altitude %@" : {
      "comment" : "In the photo details, the location the files hold, after Show Value: the latitude and longitude in degrees, then the altitude, such as 45.5231°, -122.6765°, altitude 312 m.",
      "extractionState" : "manual"
    },
    "35 mm Equivalent" : {
      "comment" : "Row in the photo details: the focal length a 35 mm film camera would need for the same field of view, in millimeters, as written in the file.",
      "extractionState" : "manual"
    },
    "Action program" : {
      "comment" : "In the photo details: the EXIF exposure program Action program, biased toward a fast shutter.",
      "extractionState" : "manual"
    },
    "Active Area" : {
      "comment" : "Row in the photo details: the DNG ActiveArea, the part of the sensor with image data, as four numbers (top, left, bottom, right).",
      "extractionState" : "manual"
    },
    "Always saved" : {
      "comment" : "Every Tag page of the photo details: every file of this format holds the tag; no setting controls it.",
      "extractionState" : "manual"
    },
    "As-Shot Neutral" : {
      "comment" : "Row in the photo details: the DNG AsShotNeutral, the white balance at capture, as one number per color.",
      "extractionState" : "manual"
    },
    "Auto bracket" : {
      "comment" : "In the photo details: the EXIF exposure mode Auto bracket, the camera took a bracket of exposures.",
      "extractionState" : "manual"
    },
    "Average" : {
      "comment" : "In the photo details: the EXIF metering mode Average.",
      "extractionState" : "manual"
    },
    "Baseline Exposure" : {
      "comment" : "Row in the photo details: the DNG BaselineExposure, in EV, that raw editors apply by default.",
      "extractionState" : "manual"
    },
    "Bit Depth" : {
      "comment" : "Row in the photo details: the bits stored for each sample of the RAW, such as 12.",
      "extractionState" : "manual"
    },
    "Black Level" : {
      "comment" : "Row in the photo details: the RAW file's black level values, as numbers.",
      "extractionState" : "manual"
    },
    "Color Filter Pattern" : {
      "comment" : "Row in the photo details: the RAW sensor's color filter pattern, as letters such as RGGB (R red, G green, B blue). Keep the letters unchanged.",
      "extractionState" : "manual"
    },
    "Compression" : {
      "comment" : "Row in the photo details: how the RAW data is compressed.",
      "extractionState" : "manual"
    },
    "Creative program" : {
      "comment" : "In the photo details: the EXIF exposure program Creative program, biased toward depth of field.",
      "extractionState" : "manual"
    },
    "Default Crop" : {
      "comment" : "Row in the photo details: the DNG default crop, its size and origin.",
      "extractionState" : "manual"
    },
    "DNG Version" : {
      "comment" : "Row in the photo details: the version of the DNG specification the RAW file follows. DNG is a file format name.",
      "extractionState" : "manual"
    },
    "Every Tag" : {
      "comment" : "Heading in the photo details: every metadata tag, block and property of each saved file.",
      "extractionState" : "manual"
    },
    "EXIF metering: Other" : {
      "comment" : "In the photo details: the EXIF metering mode Other (code 255).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other"
          }
        }
      }
    },
    "EXIF metering: Unknown" : {
      "comment" : "In the photo details: the EXIF metering mode Unknown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unknown"
          }
        }
      }
    },
    "EXIF program: Aperture priority" : {
      "comment" : "In the photo details: the EXIF exposure program Aperture priority.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperture priority"
          }
