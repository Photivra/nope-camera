    "Next, iOS asks for camera access. Photos access is asked the first time you save.": {
      "comment": "Note under Continue on the first-run screen. iOS is a product name; keep it unchanged.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als Nächstes fragt iOS nach dem Kamerazugriff. Der Zugriff auf Fotos wird beim ersten Sichern erfragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A continuación, iOS pedirá acceso a la cámara. El acceso a Fotos se pide la primera vez que guardes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ensuite, iOS demande l’accès à l’appareil photo. L’accès à Photos est demandé au premier enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poi iOS chiede l’accesso alla fotocamera. L’accesso a Foto viene chiesto la prima volta che salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "次に、iOSがカメラへのアクセスを求めます。写真へのアクセスは最初に保存するときに求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다음으로 iOS가 카메라 접근 권한을 요청합니다. 사진 접근 권한은 처음 저장할 때 요청됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
