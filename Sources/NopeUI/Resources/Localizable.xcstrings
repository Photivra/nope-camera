    "Battery at %@. Charge the device soon to keep taking photos.": {
      "comment": "Explanation of the Battery Low warning on the camera. The value is the battery charge as a percentage, such as 15%, formatted by the system.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akku bei %@. Lade das Gerät bald, um weiter zu fotografieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Batería al %@. Carga pronto el dispositivo para seguir tomando fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Batterie à %@. Rechargez bientôt l’appareil pour continuer à prendre des photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Batteria al %@. Ricarica presto il dispositivo per continuare a scattare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "バッテリー残量%@。撮影を続けるには、早めにデバイスを充電してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "배터리 %@. 계속 촬영하려면 곧 기기를 충전하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Batterij op %@. Laad het apparaat binnenkort op om foto’s te blijven maken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bateria em %@. Carregue o dispositivo logo para continuar tirando fotos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "电池电量 %@。请尽快为设备充电以继续拍照。"
          }
        },
        "zh-Hant": {
