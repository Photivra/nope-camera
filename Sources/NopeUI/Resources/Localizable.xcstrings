    "Lower quality makes smaller files, with visible compression in fine detail.": {
      "comment": "Explains the compression pickers.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geringere Qualität ergibt kleinere Dateien, mit sichtbarer Komprimierung in feinen Details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una calidad menor genera archivos más pequeños, con compresión visible en los detalles finos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une qualité inférieure donne des fichiers plus petits, avec une compression visible dans les détails fins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una qualità inferiore produce file più piccoli, con compressione visibile nei dettagli fini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "画質を下げるとファイルは小さくなりますが、細部に圧縮が目に見えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "화질을 낮추면 파일이 작아지지만 세밀한 부분에 압축 흔적이 보입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lagere kwaliteit geeft kleinere bestanden, met zichtbare compressie in fijne details."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualidade menor gera arquivos menores, com compressão visível nos detalhes finos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "降低质量可减小文件，但细节处会出现可见的压缩痕迹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "降低品質可縮小檔案，但細節處會出現可見的壓縮痕跡。"
          }
        }
      }
    },
