    "Hold it steady or use a tripod.": {
      "comment": "Hint on the camera when the light is too low for a shutter that is safe to hold by hand, or the manual shutter is that slow.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halte das Gerät ruhig oder verwende ein Stativ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén el dispositivo quieto o usa un trípode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tenez l’appareil immobile ou utilisez un trépied."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieni fermo il dispositivo o usa un treppiede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "しっかり固定するか、三脚を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "흔들리지 않게 잡거나 삼각대를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Houd het toestel stil of gebruik een statief."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenha o aparelho firme ou use um tripé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请保持稳定或使用三脚架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請保持穩定或使用三腳架。"
          }
        }
      }
    },
    "Hold the camera steady or use a tripod. Two photos are taken, a moment apart.": {
      "comment": "Hint on the camera while the comparison shot is on: nope. takes its photo and then one with the phone's processing.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halte die Kamera ruhig oder verwende ein Stativ. Es werden zwei Fotos kurz nacheinander aufgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén la cámara quieta o usa un trípode. Se toman dos fotos, una justo después de la otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tenez l’appareil immobile ou utilisez un trépied. Deux photos sont prises, à un court instant d’intervalle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieni ferma la fotocamera o usa un treppiede. Vengono scattate due foto, a breve distanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラをしっかり固定するか、三脚を使ってください。少し間をおいて2枚の写真を撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라를 흔들리지 않게 잡거나 삼각대를 사용하세요. 잠시 간격을 두고 사진 두 장을 촬영합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Houd de camera stil of gebruik een statief. Er worden twee foto’s kort na elkaar genomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenha a câmera firme ou use um tripé. Duas fotos são tiradas, com um breve intervalo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请保持相机稳定或使用三脚架。将间隔片刻拍摄两张照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請保持相機穩定或使用三腳架。將間隔片刻拍攝兩張照片。"
          }
        }
      }
    },
    "ISO Priority": {
      "comment": "Exposure mode I: the person sets ISO, the camera sets the shutter speed.",
      "extractionState": "manual",
