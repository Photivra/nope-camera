          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera non invia alcuna immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラから映像が届いていません。"
          }
        },
        "ko": {
          "stringUnit": {
