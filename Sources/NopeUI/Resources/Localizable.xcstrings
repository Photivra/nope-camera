    "nope. is free software: you can redistribute it and modify it under the terms of this license.": {
      "comment": "Plain summary of the GPL. Keep \"nope.\" unchanged.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. ist freie Software: Du kannst sie unter den Bedingungen dieser Lizenz weitergeben und ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. es software libre: puedes redistribuirlo y modificarlo según los términos de esta licencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
