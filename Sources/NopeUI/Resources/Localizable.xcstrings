        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cameratoegang toestaan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir acesso à câmera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许访问相机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許取用相機"
          }
        }
      }
    },
