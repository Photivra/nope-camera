    "Lens: %@. Format: %@.": {
      "comment": "VoiceOver value of the viewfinder. The first value is a lens name such as Wide; the second is a format such as single-frame RAW.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Objektiv: %1$@. Format: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lente: %1$@. Formato: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Objectif : %1$@. Format : %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obiettivo: %1$@. Formato: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レンズ：%1$@。フォーマット：%2$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "렌즈: %1$@. 포맷: %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lens: %1$@. Formaat: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lente: %1$@. Formato: %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "镜头：%1$@。格式：%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "鏡頭：%1$@。格式：%2$@。"
          }
        }
      }
    },
    "No Camera Available": {
      "comment": "Title when the device has no usable camera.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Kamera verfügbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay ninguna cámara disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun appareil photo disponible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
