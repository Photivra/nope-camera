    },
    "Photos keeps one copy with the RAW as a single photo. The other copy is saved as a separate photo." : {
      "comment" : "Explains why there are two items in Photos when RAW, HEIF and JPEG are all saved. Photos is the system photo library app. RAW is a file format name.",
      "extractionState" : "manual"
    },
    "Photos taken: %lld" : {
      "comment" : "Burst progress on the camera: how many photos of the running burst are taken so far.",
      "extractionState" : "manual"
    },
    "Photos that still fit on this device: about %lld." : {
      "comment" : "Explanation of the Storage Low warning on the camera. The number is an estimate of how many more photos, with the chosen formats, fit in the device's free storage.",
      "extractionState" : "manual"
    },
