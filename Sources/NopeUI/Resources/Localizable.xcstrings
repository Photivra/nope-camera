{
  "sourceLanguage": "en",
  "strings": {
    "Allow Camera Access": {
      "comment": "Button that shows the system camera permission prompt.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamerazugriff erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir acceso a la cámara"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser l’accès à l’appareil photo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti accesso alla fotocamera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラへのアクセスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라 접근 허용"
