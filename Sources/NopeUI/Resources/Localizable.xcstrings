    },
    "%@ × %@ pixels" : {
      "comment" : "In the photo details: a file's size in pixels, width by height, such as 4032 × 3024 pixels.",
      "extractionState" : "manual"
    },
    "%@ EV" : {
      "comment" : "An exposure value in EV units, such as -0.7 EV. EV means exposure value.",
      "extractionState" : "manual"
    },
    "%@ left" : {
      "comment" : "Astro card on the camera while the frames run: the exposure time of the frames still to take, such as 13s or 5m 20s, formatted by the system. Saving each frame adds time, so this is the least time left."
    },
    "%@ of photosites" : {
      "comment" : "In the photo details: a share of the RAW's photosites, such as 0.4% of photosites. A photosite is one sensor element.",
      "extractionState" : "manual"
    },
    "%@, %@" : {
      "comment" : "Two names joined, as a list of two: the two overlays that are on (the Viewfinder Overlays row's value, such as Grid, Level), and where a Settings search result is (a group, then a page) as VoiceOver reads it.\nValue of the Viewfinder Overlays row in Settings: the names of the two overlays that are on, such as Grid, Level.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, in %@" : {
      "comment" : "VoiceOver: a Settings search result, the setting's name, then where it is.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, in %2$@"
          }
        }
      }
    },
    "%lld More Settings Changed" : {
      "comment" : "VoiceOver name of the +n pill on the camera: how many more settings are not at their defaults. The number is a count of settings.",
      "extractionState" : "manual"
    },
    "%lld MP (%lld × %lld)" : {
      "comment" : "A photo size choice: megapixels (MP), then the width and height in pixels, such as 12 MP (4032 × 3024).",
      "extractionState" : "manual"
    },
    "%lld of %lld photos taken" : {
      "comment" : "Interval shooting progress: how many photos of the series are taken so far. Both numbers are counts of photos; the second is at least 2.",
      "extractionState" : "manual"
    },
    "%lld On" : {
      "comment" : "Value of the Viewfinder Overlays row in Settings when three or more overlays are on: how many. The number is at least 3.",
      "extractionState" : "manual"
    },
    "%lld Saved" : {
      "comment" : "Value of the Presets tile in the Quick Menu and of the Presets row in Settings: how many presets the person has saved, at least 1. Keep it short: it sits in a small tile under the name Presets, so a counter word alone is enough where that reads naturally.",
      "extractionState" : "manual"
    },
    "4 × 4" : {
      "comment" : "Grid style: three lines each way, dividing the picture into 4 by 4.",
      "extractionState" : "manual"
    },
    "8-bit" : {
      "comment" : "HEIF bit depth choice: 8 bits per color channel.",
      "extractionState" : "manual"
    },
    "10-bit" : {
      "comment" : "HEIF bit depth choice: 10 bits per color channel.",
      "extractionState" : "manual"
    },
    "10-bit keeps smoother gradients. 8-bit files are smaller." : {
      "comment" : "Explains the HEIF bit depth picker.",
      "extractionState" : "manual"
    },
    "A horizon bar, or a top-down level when you point straight down. On iPhone, you feel a tap when it's level. Uses the motion sensors only while it shows." : {
      "comment" : "Explains the Level switch.",
      "extractionState" : "manual"
    },
    "A preset holds every setting: photos, privacy, camera, and the lens, exposure and drive mode. A preset that includes Location still asks for location access." : {
      "comment" : "Explains what a settings preset contains. Location is the name of the privacy switch.",
      "extractionState" : "manual"
    },
    "About and Licenses" : {
      "comment" : "Settings row and screen title: version, license and third-party notices.",
      "extractionState" : "manual"
    },
    "Accessibility" : {
      "comment" : "Settings row and screen title: taking photos without looking at the screen (hardware buttons, haptics, spoken feedback).",
      "extractionState" : "manual"
    },
    "Adding to Photos" : {
      "comment" : "Timing in the photo details: adding the files to the photo library. Photos is the system photo library app.",
      "extractionState" : "manual"
    },
    "After %@ · %@ in all · at most %@" : {
      "comment" : "Astro card on the camera, before the frames start: the start delay (a duration such as \"10 seconds\"), the total time of all frames (such as \"20 s\"), and the most storage they can use (such as \"486 MB\"). All three values are formatted by the system.",
      "extractionState" : "manual"
    },
    "All" : {
      "comment" : "Live readout value: every listed processing feature is off.",
      "extractionState" : "manual"
    },
    "All Auto" : {
      "comment" : "Button that returns every manual control to automatic in one tap.",
      "extractionState" : "manual"
    },
    "All controls on Auto" : {
      "comment" : "VoiceOver announcement after All Auto returned every manual control to Auto. Manual Controls stay on, so don't say \"full auto\". \"Auto\" is the word on a manual readout; use its translation.",
      "extractionState" : "manual"
    },
    "All Photo Settings" : {
      "comment" : "Button on the Photo Format sheet: closes the sheet and opens Settings at the Photos group (formats, HEIF and JPEG copies, photo size).",
      "extractionState" : "manual"
    },
    "Another preset has this name." : {
      "comment" : "Shown under the preset name field when a saved preset already has the name.",
      "extractionState" : "manual"
    },
    "Aperture" : {
      "comment" : "Name of the lens aperture (f-number) control.",
      "extractionState" : "manual"
    },
    "Applies every setting in the preset." : {
      "comment" : "VoiceOver hint of a settings preset in the list.",
      "extractionState" : "manual"
    },
    "Apply a Preset" : {
      "comment" : "Header of the list of settings presets: tapping one applies all of its settings.",
      "extractionState" : "manual"
    },
    "Astro" : {
      "comment" : "Quick control, pill and its Voice Control name on the camera: the helper for night sky photos, which takes a series of single RAW frames for stacking in other software.",
      "extractionState" : "manual"
    },
    "Astro finished. Frames saved: %lld" : {
      "comment" : "Announced to VoiceOver when the night sky helper has taken all its frames. The number is how many frames were saved.",
      "extractionState" : "manual"
    },
    "Astro frames started." : {
      "comment" : "Announced to VoiceOver when the night sky helper starts taking its frames.",
      "extractionState" : "manual"
    },
    "Astro frames: %lld" : {
      "comment" : "Shown on the camera while the night sky helper is on: how many frames the shutter will take.",
      "extractionState" : "manual"
    },
    "Astro on. Manual controls and night mode are on." : {
      "comment" : "Announced to VoiceOver when Astro is chosen on the drive strip: Astro also turns on the manual controls and night mode.",
      "extractionState" : "manual"
    },
    "Astro on. Manual controls are on." : {
      "comment" : "Announced to VoiceOver when Astro comes on while night mode is off, for example from a settings preset: Astro also turns on the manual controls.",
      "extractionState" : "manual"
    },
    "Astro Settings" : {
      "comment" : "Button on the camera and title of the sheet with the night sky helper's frame count, start delay and estimates.",
      "extractionState" : "manual"
    },
    "Astro stopped: storage is full. Frames saved: %lld" : {
      "comment" : "Announced to VoiceOver when the night sky helper stops because the next frame wouldn't fit in storage. The number is how many frames were saved.",
      "extractionState" : "manual"
    },
    "Astro stopped: the battery is low. Frames saved: %lld" : {
      "comment" : "Announced to VoiceOver when the night sky helper stops because the battery is nearly empty and not charging. The number is how many frames were saved.",
      "extractionState" : "manual"
    },
    "Astro stopped: the camera stopped. Frames saved: %lld" : {
      "comment" : "Announced to VoiceOver when the night sky helper stops because the camera was interrupted or switched lenses. The number is how many frames were saved.",
      "extractionState" : "manual"
    },
    "Astro. Press to start the frames after the start delay." : {
      "comment" : "VoiceOver value of the shutter while the night sky helper is on: one press starts the self-timer, then the series of frames.",
      "extractionState" : "manual"
    },
    "At least one format is required." : {
      "comment" : "Explains why the last selected format can't be turned off.",
      "extractionState" : "manual"
    },
    "Auto" : {
      "comment" : "A control set automatically by the camera.",
      "extractionState" : "manual"
    },
    "Autofocus and auto exposure follow faces the camera finds." : {
      "comment" : "Explains the Focus on Faces switch. It decides only whether nope.'s autofocus and auto exposure follow faces; don't describe it as turning face detection off."
    },
    "Battery at %@. Charge the device soon to keep taking photos." : {
      "comment" : "Explanation of the Battery Low warning on the camera. The value is the battery charge as a percentage, such as 3%, formatted by the system.",
      "extractionState" : "manual"
    },
    "Battery at %@. Low Power Mode is on." : {
      "comment" : "Explanation of the Battery Low warning on the camera while Low Power Mode is on. The value is the battery charge as a percentage, such as 3%, formatted by the system. Low Power Mode is Apple's name for the iPhone and iPad setting.",
      "extractionState" : "manual"
    },
    "Battery Low" : {
      "comment" : "Warning chip on the camera: the battery is low and the device isn't charging.",
      "extractionState" : "manual"
    },
    "Bias / Offset" : {
      "comment" : "Live readout line: the exposure compensation set, then how far the metered exposure is from the camera's target, both in EV.",
      "extractionState" : "manual"
    },
    "Blue" : {
      "comment" : "In the photo details: the blue photosites of the RAW sensor's color filter.",
      "extractionState" : "manual"
    },
    "Bracketing" : {
      "comment" : "Switch for exposure bracketing: several photos at different exposures from one press.",
      "extractionState" : "manual"
