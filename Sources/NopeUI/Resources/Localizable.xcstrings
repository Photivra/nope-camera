    "Smaller copies are quicker to share and take less space. The RAW keeps every pixel.": {
      "comment": "Explains the copy size picker. RAW is a file format name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kleinere Kopien lassen sich schneller teilen und brauchen weniger Platz. Das RAW behält jedes Pixel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las copias más pequeñas se comparten más rápido y ocupan menos espacio. El RAW conserva todos los píxeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les copies plus petites se partagent plus vite et prennent moins de place. Le RAW garde tous les pixels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le copie più piccole si condividono più in fretta e occupano meno spazio. Il RAW conserva ogni pixel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "小さいコピーは共有が速く、容量も少なくて済みます。RAWはすべてのピクセルを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작은 사본은 더 빨리 공유되고 공간을 덜 차지합니다. RAW는 모든 픽셀을 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kleinere kopieën zijn sneller te delen en nemen minder ruimte in. De RAW houdt elke pixel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cópias menores são mais rápidas de compartilhar e ocupam menos espaço. O RAW mantém todos os pixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "较小的副本分享更快，占用空间更少。RAW 保留每一个像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "較小的副本分享更快，佔用空間更少。RAW 保留每一個像素。"
          }
        }
      }
    },
