    },
    "The camera isn't sending a picture.": {
      "comment": "Shown over the viewfinder when the camera runs but every picture it delivers is blank, even after the app restarted the camera.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
