        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cámara no está enviando imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo n’envoie pas d’image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera non invia alcuna immagine."
          }
        },
        "ja": {
