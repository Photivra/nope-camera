{
  "sourceLanguage": "en",
  "strings": {
    "Allow Camera Access": {
      "comment": "Button that shows the system camera permission prompt.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamerazugriff erlauben"
          }
        },
        "es": {
