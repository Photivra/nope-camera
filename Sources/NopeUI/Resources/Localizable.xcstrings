    "Screen dimmed to save battery. Tap to brighten it.": {
      "comment": "Shown over the dimmed screen, and announced to VoiceOver, when interval shooting starts and the app dims the screen to save battery.",
      "extractionState": "manual",
      "localizations": {
        "de": {
