    "The camera couldn't start. Try another lens.": {
      "comment": "Shown over the viewfinder when the camera fails to start.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera konnte nicht starten. Versuche ein anderes Objektiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo iniciar la cámara. Prueba con otra lente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de démarrer l’appareil photo. Essayez un autre objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile avviare la fotocamera. Prova un altro obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
