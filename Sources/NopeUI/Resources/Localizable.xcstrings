    "Stop Bracket" : {
      "comment" : "Button on the focus bracket card while it runs: stops after the current frame; every photo taken is kept.",
      "extractionState" : "manual"
    },
    "Storage is full." : {
      "comment" : "Focus bracket card: the series stopped because the next photo wouldn't fit in the device's free storage.",
      "extractionState" : "manual"
    },
    "Subject Area" : {
      "comment" : "Row in the photo details: where the subject is in the picture, as two to four numbers in pixels, as written in the file.",
