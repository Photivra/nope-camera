{
  "sourceLanguage" : "en",
  "strings" : {
    "Photo Format sheet: Formats for Other Lenses" : {
      "comment" : "Button on the Photo Format sheet of a lens that can't save RAW: closes the sheet and opens Settings at Formats, where the formats of the other lenses are chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formats for Other Lenses"
          }
        }
      }
    },
    "Photo Format sheet: This Lens Saves" : {
      "comment" : "Section header on the Photo Format sheet of a lens that can't save RAW, above the one file format that lens saves (for example HEIF). The list can't be changed there.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Lens Saves"
          }
        }
      }
    },
    "“%@” applied." : {
      "comment" : "Shown after a saved settings preset was applied. The placeholder is the preset's name, in the language's quotation marks.",
      "extractionState" : "manual"
    },
    "%@ › %@" : {
      "comment" : "Settings search result: where a setting is, a group name, then a page name. Keep the order and separator that read naturally in the language.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ › %2$@"
          }
        }
      }
    },
    "%@ × %@ pixels" : {
      "comment" : "In the photo details: a file's size in pixels, width by height, such as 4032 × 3024 pixels.",
      "extractionState" : "manual"
    },
    "%@ EV" : {
      "comment" : "An exposure value in EV units, such as -0.7 EV. EV means exposure value.",
      "extractionState" : "manual"
    },
    "%@ left" : {
      "comment" : "Astro card on the camera while the frames run: the exposure time of the frames still to take, such as 13s or 5m 20s, formatted by the system. Saving each frame adds time, so this is the least time left."
    },
    "%@ of photosites" : {
      "comment" : "In the photo details: a share of the RAW's photosites, such as 0.4% of photosites. A photosite is one sensor element.",
      "extractionState" : "manual"
    },
    "%@, %@" : {
      "comment" : "Two names joined, as a list of two: the two overlays that are on (the Viewfinder Overlays row's value, such as Grid, Level), and where a Settings search result is (a group, then a page) as VoiceOver reads it.\nValue of the Viewfinder Overlays row in Settings: the names of the two overlays that are on, such as Grid, Level.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, in %@" : {
      "comment" : "VoiceOver: a Settings search result, the setting's name, then where it is.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, in %2$@"
          }
        }
      }
    },
    "%lld More Settings Changed" : {
      "comment" : "VoiceOver name of the +n pill on the camera: how many more settings are not at their defaults. The number is a count of settings.",
      "extractionState" : "manual"
    },
    "%lld MP (%lld × %lld)" : {
      "comment" : "A photo size choice: megapixels (MP), then the width and height in pixels, such as 12 MP (4032 × 3024).",
      "extractionState" : "manual"
    },
    "%lld of %lld photos taken" : {
      "comment" : "Interval shooting progress: how many photos of the series are taken so far. Both numbers are counts of photos; the second is at least 2.",
      "extractionState" : "manual"
    },
    "%lld On" : {
      "comment" : "Value of the Viewfinder Overlays row in Settings when three or more overlays are on: how many. The number is at least 3.",
      "extractionState" : "manual"
    },
    "%lld Saved" : {
      "comment" : "Value of the Presets tile in the Quick Menu and of the Presets row in Settings: how many presets the person has saved, at least 1. Keep it short: it sits in a small tile under the name Presets, so a counter word alone is enough where that reads naturally.",
      "extractionState" : "manual"
    },
    "4 × 4" : {
      "comment" : "Grid style: three lines each way, dividing the picture into 4 by 4.",
      "extractionState" : "manual"
    },
    "8-bit" : {
      "comment" : "HEIF bit depth choice: 8 bits per color channel.",
      "extractionState" : "manual"
    },
    "10-bit" : {
      "comment" : "HEIF bit depth choice: 10 bits per color channel.",
      "extractionState" : "manual"
    },
    "10-bit keeps smoother gradients. 8-bit files are smaller." : {
      "comment" : "Explains the HEIF bit depth picker.",
      "extractionState" : "manual"
    },
    "A horizon bar, or a top-down level when you point straight down. Uses the motion sensors only while it shows." : {
      "comment" : "Explains the Level switch.",
      "extractionState" : "manual"
    },
    "A preset holds every setting: photos, privacy, camera, and the lens, exposure and drive mode. A preset that includes Location still asks for location access." : {
      "comment" : "Explains what a settings preset contains. Location is the name of the privacy switch.",
      "extractionState" : "manual"
    },
    "About and Licenses" : {
      "comment" : "Settings row and screen title: version, license and third-party notices.",
      "extractionState" : "manual"
    },
    "Accessibility" : {
      "comment" : "Settings row and screen title: taking photos without looking at the screen (hardware buttons, haptics, spoken feedback).",
      "extractionState" : "manual"
    },
    "Adding to Photos" : {
      "comment" : "Timing in the photo details: adding the files to the photo library. Photos is the system photo library app.",
      "extractionState" : "manual"
    },
    "After %@ · %@ in all · at most %@" : {
      "comment" : "Astro card on the camera, before the frames start: the start delay (a duration such as \"10 seconds\"), the total time of all frames (such as \"20 s\"), and the most storage they can use (such as \"486 MB\"). All three values are formatted by the system.",
      "extractionState" : "manual"
    },
    "All" : {
      "comment" : "Live readout value: every listed processing feature is off.",
      "extractionState" : "manual"
    },
    "All Auto" : {
      "comment" : "Button that returns every manual control to automatic in one tap.",
      "extractionState" : "manual"
    },
    "All Photo Settings" : {
      "comment" : "Button on the Photo Format sheet: closes the sheet and opens Settings at the Photos group (formats, HEIF and JPEG copies, photo size).",
      "extractionState" : "manual"
    },
    "Another preset has this name." : {
      "comment" : "Shown under the preset name field when a saved preset already has the name.",
      "extractionState" : "manual"
    },
    "Aperture" : {
      "comment" : "Name of the lens aperture (f-number) control.",
      "extractionState" : "manual"
    },
    "Applies every setting in the preset." : {
      "comment" : "VoiceOver hint of a settings preset in the list.",
      "extractionState" : "manual"
    },
    "Apply a Preset" : {
      "comment" : "Header of the list of settings presets: tapping one applies all of its settings.",
      "extractionState" : "manual"
    },
    "Astro" : {
      "comment" : "Quick control, pill and its Voice Control name on the camera: the helper for night sky photos, which takes a series of single RAW frames for stacking in other software.",
      "extractionState" : "manual"
    },
    "Astro finished. Frames saved: %lld" : {
      "comment" : "Announced to VoiceOver when the night sky helper has taken all its frames. The number is how many frames were saved.",
      "extractionState" : "manual"
    },
    "Astro frames started." : {
      "comment" : "Announced to VoiceOver when the night sky helper starts taking its frames.",
      "extractionState" : "manual"
    },
    "Astro frames: %lld" : {
      "comment" : "Shown on the camera while the night sky helper is on: how many frames the shutter will take.",
      "extractionState" : "manual"
    },
    "Astro on. Manual controls and night mode are on." : {
      "comment" : "Announced to VoiceOver when Astro is chosen on the drive strip: Astro also turns on the manual controls and night mode.",
      "extractionState" : "manual"
    },
    "Astro on. Manual controls are on." : {
      "comment" : "Announced to VoiceOver when Astro comes on while night mode is off, for example from a settings preset: Astro also turns on the manual controls.",
      "extractionState" : "manual"
    },
    "Astro Settings" : {
      "comment" : "Button on the camera and title of the sheet with the night sky helper's frame count, start delay and estimates.",
      "extractionState" : "manual"
    },
    "Astro stopped: storage is full. Frames saved: %lld" : {
      "comment" : "Announced to VoiceOver when the night sky helper stops because the next frame wouldn't fit in storage. The number is how many frames were saved.",
      "extractionState" : "manual"
    },
    "Astro stopped: the battery is low. Frames saved: %lld" : {
      "comment" : "Announced to VoiceOver when the night sky helper stops because the battery is nearly empty and not charging. The number is how many frames were saved.",
      "extractionState" : "manual"
    },
    "Astro stopped: the camera stopped. Frames saved: %lld" : {
      "comment" : "Announced to VoiceOver when the night sky helper stops because the camera was interrupted or switched lenses. The number is how many frames were saved.",
      "extractionState" : "manual"
    },
    "Astro. Press to start the frames after the start delay." : {
      "comment" : "VoiceOver value of the shutter while the night sky helper is on: one press starts the self-timer, then the series of frames.",
      "extractionState" : "manual"
    },
    "At least one format is required." : {
      "comment" : "Explains why the last selected format can't be turned off.",
      "extractionState" : "manual"
    },
    "Auto" : {
      "comment" : "A control set automatically by the camera.",
      "extractionState" : "manual"
    },
    "Autofocus and auto exposure follow faces the camera finds." : {
      "comment" : "Explains the Focus on Faces switch. It decides only whether nope.'s autofocus and auto exposure follow faces; don't describe it as turning face detection off."
    },
    "Battery at %@. Charge the device soon to keep taking photos." : {
      "comment" : "Explanation of the Battery Low warning on the camera. The value is the battery charge as a percentage, such as 3%, formatted by the system.",
      "extractionState" : "manual"
    },
    "Battery at %@. Low Power Mode is on." : {
      "comment" : "Explanation of the Battery Low warning on the camera while Low Power Mode is on. The value is the battery charge as a percentage, such as 3%, formatted by the system. Low Power Mode is Apple's name for the iPhone and iPad setting.",
      "extractionState" : "manual"
    },
    "Battery Low" : {
      "comment" : "Warning chip on the camera: the battery is low and the device isn't charging.",
      "extractionState" : "manual"
    },
    "Bias / Offset" : {
      "comment" : "Live readout line: the exposure compensation set, then how far the metered exposure is from the camera's target, both in EV.",
      "extractionState" : "manual"
    },
    "Bit depth: %lld" : {
      "comment" : "In the photo details: a file's bit depth, the number of bits stored for each sample, such as 16.",
      "extractionState" : "manual"
    },
    "Black level: %@" : {
      "comment" : "In the photo details: the RAW file's black level values, as numbers.",
      "extractionState" : "manual"
    },
    "Blue" : {
      "comment" : "In the photo details: the blue photosites of the RAW sensor's color filter.",
      "extractionState" : "manual"
    },
    "Bracketing" : {
      "comment" : "Switch for exposure bracketing: several photos at different exposures from one press.",
      "extractionState" : "manual"
    },
    "Brighten Screen" : {
      "comment" : "VoiceOver and Voice Control name of the button that covers the dimmed screen during interval shooting; it restores the brightness.",
      "extractionState" : "manual"
    },
    "Brighter" : {
      "comment" : "Button on the exposure dial: one third of a stop brighter.",
      "extractionState" : "manual"
    },
    "Brightness %@" : {
      "comment" : "Action of the Light pill on the camera: sets the light's brightness. The value is a percentage such as 25%.",
      "extractionState" : "manual"
    },
    "Burst" : {
      "comment" : "Drive menu option on the camera: holding the shutter takes a rapid run of separate photos.",
      "extractionState" : "manual"
    },
    "Burst started." : {
      "comment" : "Announced to VoiceOver when a burst starts.",
      "extractionState" : "manual"
    },
    "Burst stopped at %lld photos, the most one burst takes." : {
      "comment" : "Announced and shown when a burst stops because it reached its maximum number of photos. The number is that count of photos, such as 50.",
      "extractionState" : "manual"
    },
    "Burst stopped: storage is full." : {
      "comment" : "Announced and shown when a burst stops because the next photo wouldn't fit in the device's free storage.",
      "extractionState" : "manual"
    },
    "Burst stopped: the camera stopped." : {
      "comment" : "Announced and shown when a burst stops because the camera was interrupted or switched lenses.",
      "extractionState" : "manual"
    },
    "Burst. Press to start, press again to stop." : {
      "comment" : "VoiceOver value of the shutter in burst mode: one press starts a rapid run of separate photos, the next press stops it.",
      "extractionState" : "manual"
    },
    "Camera" : {
      "comment" : "Settings section header for how the camera screen looks and works. Also the name of the menu with camera commands in the iPad menu bar.",
      "extractionState" : "manual"
    },
    "Camera Access Is Off" : {
      "comment" : "Title when camera access was declined.",
      "extractionState" : "manual"
    },
    "Cancel Timer" : {
      "comment" : "Button that stops the self-timer without taking a photo.",
      "extractionState" : "manual"
    },
    "Center" : {
      "comment" : "Metering mode: the camera measures a region at the center of the frame.",
      "extractionState" : "manual"
    },
    "Clipped Highlights" : {
      "comment" : "Row in the photo details: the share of the RAW's photosites recorded at or near the white level (full).",
      "extractionState" : "manual"
    },
    "Clipped Shadows" : {
      "comment" : "Row in the photo details: the share of the RAW's photosites recorded at or near the black level (no signal).",
      "extractionState" : "manual"
    },
    "Clipping in the RAW" : {
      "comment" : "Heading in the photo details: how much of the RAW sensor data is clipped (recorded as full white or as black). RAW is a file format name.",
      "extractionState" : "manual"
    },
    "Close Exposure" : {
      "comment" : "Button that closes the exposure compensation dial on the camera.",
      "extractionState" : "manual"
    },
    "Close-Up" : {
      "comment" : "Quick control and pill on the camera: limits autofocus to near subjects, for small things close to the lens.",
      "extractionState" : "manual"
    },
    "Closest to Far" : {
      "comment" : "The range of the relative focus scale, from the closest focus to far. Not a distance.",
      "extractionState" : "manual"
    },
    "Cloudy" : {
      "comment" : "White balance preset for an overcast sky.",
      "extractionState" : "manual"
    },
    "Color filter pattern: %@" : {
      "comment" : "In the photo details: the RAW sensor's color filter pattern, as letters such as RGGB (R red, G green, B blue). Keep the letters unchanged.",
      "extractionState" : "manual"
    },
    "Color Space" : {
      "comment" : "Picker: the color space of the HEIF and JPEG copies (Display P3 or sRGB).",
      "extractionState" : "manual"
    },
    "Compare" : {
      "comment" : "Title of the compare view, and the camera switch and its Voice Control name that turns the comparison shot on: nope.'s photo next to the phone-processed version, which isn't saved.",
      "extractionState" : "manual"
    },
    "Comparison" : {
      "comment" : "VoiceOver name of the compare view's picture: nope.'s photo and the phone-processed version, split by a divider. Swipe up or down to move the divider.",
      "extractionState" : "manual"
    },
    "Comparison hidden while nope. is in the background" : {
      "comment" : "Shown over the compare view while the app isn't in front, so the app switcher doesn't show the photos. Keep \"nope.\" unchanged.",
      "extractionState" : "manual"
    },
    "Constant color" : {
      "comment" : "Live readout: the camera feature that corrects colors under mixed light.",
      "extractionState" : "manual"
    },
    "Content-aware distortion fix" : {
      "comment" : "Live readout: the camera feature that corrects distortion based on what is in the picture.",
      "extractionState" : "manual"
    },
    "Continue" : {
      "comment" : "Button on the first-run screen: goes on to the system camera access prompt.",
      "extractionState" : "manual"
    },
    "Continuous" : {
      "comment" : "Live readout value: continuous autofocus.",
      "extractionState" : "manual"
    },
    "Copy Size" : {
      "comment" : "Picker: the width and height of the HEIF and JPEG copies, compared with the RAW.",
      "extractionState" : "manual"
    },
    "Couldn't undo: the camera is busy, or the earlier settings can't be read. Nothing changed." : {
      "comment" : "Shown and spoken when Undo in the presets list changed nothing."
    },
    "Count: %lld" : {
      "comment" : "Compare view: how many times a container block appears in a file.",
      "extractionState" : "manual"
    },
    "Counting down. Press to cancel." : {
      "comment" : "VoiceOver value of the shutter while the self-timer counts down: pressing the shutter cancels the photo.",
      "extractionState" : "manual"
    },
    "Critical" : {
      "comment" : "Live readout value: the camera system's pressure level is critical.",
      "extractionState" : "manual"
    },
    "Custom" : {
      "comment" : "Live readout value: exposure is set to a custom ISO and shutter (manual).",
      "extractionState" : "manual"
    },
    "Darker" : {
      "comment" : "Button on the exposure dial: one third of a stop darker.",
      "extractionState" : "manual"
    },
    "Daylight" : {
      "comment" : "White balance preset for direct daylight.",
      "extractionState" : "manual"
    },
    "Decrease" : {
      "comment" : "Button on a manual control's dial: one step lower.",
      "extractionState" : "manual"
    },
    "Deferred processing" : {
      "comment" : "Live readout: the camera feature that finishes processing a photo later.",
      "extractionState" : "manual"
    },
    "Delete" : {
      "comment" : "Menu item, swipe action and VoiceOver action on a saved preset: asks first, then deletes it.",
      "extractionState" : "manual"
    },
    "Delete “%@”?" : {
      "comment" : "Title of the confirmation before deleting a saved preset. The placeholder is the preset's name; use your language's quotation marks.",
      "extractionState" : "manual"
    },
    "Delete Preset" : {
      "comment" : "Button that deletes a saved settings preset. The current settings don't change.",
      "extractionState" : "manual"
    },
    "Deleting a preset doesn't change your current settings." : {
      "comment" : "Shown under the Delete Preset button.",
      "extractionState" : "manual"
    },
    "Details" : {
      "comment" : "Button and screen title in the compare view: the metadata of nope.'s photo and of the phone-processed version, side by side.",
      "extractionState" : "manual"
    },
    "Developing" : {
      "comment" : "Timing in the photo details: developing the HEIF and JPEG from the RAW.",
      "extractionState" : "manual"
    },
    "Didn't fire" : {
      "comment" : "In the photo details, the flash as the file records it: the flash didn't fire for this photo.",
      "extractionState" : "manual"
    },
    "Dismiss" : {
      "comment" : "Button that closes the message about a photo that wasn't taken or saved.",
      "extractionState" : "manual"
    },
    "Display P3 keeps the camera's colors. sRGB suits sites and screens that show only sRGB; colors outside it are clipped." : {
      "comment" : "Explains the color space picker. Display P3 and sRGB are color space names; keep them unchanged.",
      "extractionState" : "manual"
    },
    "Divider" : {
      "comment" : "Name of the slider in the compare view that moves the divider between nope.'s photo and the phone-processed version.",
      "extractionState" : "manual"
    },
    "Done" : {
      "comment" : "Button that closes a sheet, such as Settings or Pro Tools.",
      "extractionState" : "manual"
    },
    "Drive" : {
      "comment" : "Quick control on the camera: a menu that chooses what the shutter does: one photo, a self-timer, or a burst.",
      "extractionState" : "manual"
    },
    "Drive strip: Interval" : {
      "comment" : "Drive mode word in the strip above the shutter: a series of photos at a fixed interval. A short word; the strip holds five.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interval"
          }
        }
      }
    },
    "Drive strip: Single" : {
      "comment" : "Drive mode word in the strip above the shutter: each press takes one photo. A short word; the strip holds five.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single"
          }
        }
      }
    },
    "Drive strip: Timer" : {
      "comment" : "Drive mode word in the strip above the shutter: a self-timer of 3 or 10 seconds. A short word; the strip holds five.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer"
          }
        }
      }
    },
    "Each Frame" : {
      "comment" : "Section title in the night sky helper's settings: the exposure every frame is taken with.",
      "extractionState" : "manual"
    },
    "Each photo is taken in full auto, or with your manual settings while Manual Controls are on." : {
      "comment" : "Explains which exposure the photos of an interval series use. \"Manual Controls\" is the option's name in Settings.",
      "extractionState" : "manual"
    },
    "Enter a name." : {
      "comment" : "Shown under the preset name field when it is empty.",
      "extractionState" : "manual"
    },
    "EV" : {
      "comment" : "Short label of the exposure compensation control in the control grid. EV means exposure value.",
      "extractionState" : "manual"
    },
    "Every %@, %lld photos" : {
      "comment" : "Interval card on the camera, before a series starts: the time between photos, then how many photos the series takes. The first placeholder is a duration formatted by the system, such as \"10 seconds\"; the number is at least 2.",
      "extractionState" : "manual"
    },
    "Every setting as on a fresh install. Saved presets are kept." : {
      "comment" : "Explains the Factory Defaults preset.",
      "extractionState" : "manual"
    },
    "Exposure" : {
      "comment" : "Name of the exposure compensation control in full auto, in the quick-controls tray and on its dial.",
      "extractionState" : "manual"
    },
    "Exposure and Focus Lock" : {
      "comment" : "VoiceOver and Voice Control name of the lock pill on the camera, shown while exposure or focus is locked.",
      "extractionState" : "manual"
    },
    "Exposure as Written" : {
      "comment" : "Heading in the photo details: the shutter speed, ISO, aperture and other exposure values exactly as the saved file records them.",
      "extractionState" : "manual"
    },
    "Exposure Compensation" : {
      "comment" : "Name of the exposure compensation control (makes photos brighter or darker than the meter's reading).",
      "extractionState" : "manual"
    },
    "Exposure compensation works only while ISO or the shutter is on Auto." : {
      "comment" : "Explains why exposure compensation is disabled when ISO and shutter are both set manually.",
      "extractionState" : "manual"
    },
    "Exposure Lock (AE-L)" : {
      "comment" : "Switch that locks auto exposure. AE-L is the usual camera abbreviation.",
      "extractionState" : "manual"
    },
    "Exposure Mode" : {
      "comment" : "Name of the picker for the exposure mode: P, S, I or M.",
      "extractionState" : "manual"
    },
    "Exposure Time in All" : {
      "comment" : "Row in the night sky helper's settings: the shutter time of all frames added together.",
      "extractionState" : "manual"
    },
    "Factory Defaults" : {
      "comment" : "Built-in settings preset that returns every setting to what a fresh install has.",
      "extractionState" : "manual"
    },
    "Factory Defaults applied." : {
      "comment" : "Shown after the Factory Defaults preset was applied.",
      "extractionState" : "manual"
    },
    "Fair" : {
      "comment" : "Live readout value: the camera system's pressure level is slightly raised.",
      "extractionState" : "manual"
    },
    "Far" : {
      "comment" : "Focus position in the farthest third of the lens's relative range, toward infinity. Not a distance.",
      "extractionState" : "manual"
    },
    "Far Focus" : {
      "comment" : "Quick control and pill on the camera: limits autofocus to far subjects, such as a landscape seen past near branches.",
      "extractionState" : "manual"
    },
    "Fast Shutter" : {
      "comment" : "Setting and quick control: how fast a shutter full auto prefers, to avoid blur.",
      "extractionState" : "manual"
    },
    "Fast shutter: Standard" : {
      "comment" : "Fast shutter choice: full auto aims for a shutter fast enough to hold by hand. The default.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard"
          }
        }
      }
    },
    "Feedback" : {
      "comment" : "Accessibility screen section header: haptics and spoken feedback.",
      "extractionState" : "manual"
    },
    "Files" : {
      "comment" : "Heading in the photo details: the files saved for this photo.",
      "extractionState" : "manual"
    },
