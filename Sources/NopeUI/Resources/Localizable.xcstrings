    "Lower quality makes smaller files, with visible compression in fine detail.": {
      "comment": "Explains the compression pickers.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geringere Qualität ergibt kleinere Dateien, mit sichtbarer Komprimierung in feinen Details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una calidad menor genera archivos más pequeños, con compresión visible en los detalles finos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une qualité inférieure donne des fichiers plus petits, avec une compression visible dans les détails fins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una qualità inferiore produce file più piccoli, con compressione visibile nei dettagli fini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "画質を下げるとファイルは小さくなりますが、細部に圧縮が目に見えるようになります。"
