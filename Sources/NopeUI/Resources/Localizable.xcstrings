    },
    "Paired with RAW" : {
      "comment" : "Picker: which processed copy (HEIF or JPEG) Photos keeps together with the RAW. RAW is a file format name.",
      "extractionState" : "manual"
    },
    "Paused: %lld of %lld frames" : {
      "comment" : "Shown on the camera while the night sky helper's frames are paused because the camera is paused (for example by a call): they continue, after the start delay, when the camera is back. Both numbers are counts of frames.",
      "extractionState" : "manual"
    },
    "Paused: %lld of %lld photos taken" : {
      "comment" : "Interval shooting progress while the series is paused because the camera is paused (for example by a call) or nope. is in the background: it continues when the camera is back. Both numbers are counts of photos; the second is at least 2. Keep \"nope.\" unchanged.",
      "extractionState" : "manual"
    },
    "Phone Only" : {
      "comment" : "Button in the compare view: shows only the phone-processed version.",
      "extractionState" : "manual"
    },
    "Phone Processing" : {
      "comment" : "Compare view: the label of the side that shows the photo with the phone's full processing, which isn't saved.",
      "extractionState" : "manual"
    },
    "Phone: %@" : {
      "comment" : "Compare view: the value the phone-processed version holds for a metadata item.",
      "extractionState" : "manual"
    },
    "Photivra, Nope Camera, the app icon and the wordmark are trademarks and aren't covered by the GPL." : {
      "comment" : "Trademark statement. Keep Photivra, Nope Camera and GPL unchanged.",
      "extractionState" : "manual"
    },
    "Photo" : {
      "comment" : "Label of the picker that chooses which photo of an exposure bracket the details show.",
      "extractionState" : "manual"
    },
    "Photo %lld of %lld" : {
      "comment" : "Choice in the photo details of an exposure bracket: which of its photos to show. The first number is the photo, the second the count.",
      "extractionState" : "manual"
    },
    "Photo Details" : {
      "comment" : "Button and VoiceOver action on the last-photo thumbnail: shows the facts read back from the photo nope. just saved. Keep nope. unchanged if it appears.",
      "extractionState" : "manual"
    },
    "Photo in %@" : {
      "comment" : "Self-timer progress on the camera: the photo is taken after this many seconds. The value is a short number of seconds, such as 3s, formatted by the system.",
      "extractionState" : "manual"
    },
    "Photo Size" : {
      "comment" : "Settings row and screen title: the size of photos from lenses that offer more than one.",
      "extractionState" : "manual"
    },
