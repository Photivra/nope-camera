          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系統已暫停相機，稍後會自動恢復。"
          }
        }
      }
    },
    "The camera is paused to let your device cool down.": {
      "comment": "Shown over the viewfinder when the device is too hot to run the camera.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera ist pausiert, damit dein Gerät abkühlen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cámara está en pausa para que el dispositivo se enfríe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo est en pause pour laisser votre appareil refroidir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera è in pausa per far raffreddare il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
