          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera neemt foto’s. Probeer het opnieuw als hij klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A câmera está tirando fotos. Tente de novo quando terminar."
