      "extractionState" : "manual"
    },
    "“%@” applied." : {
      "comment" : "Shown after a saved settings preset was applied. The placeholder is the preset's name, in the language's quotation marks.",
      "extractionState" : "manual"
    },
    "%@ › %@" : {
      "comment" : "Settings search result: where a setting is, a group name, then a page name. Keep the order and separator that read naturally in the language.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ › %2$@"
          }
        }
