    },
    "Values shown." : {
      "comment" : "VoiceOver announcement after Show Hidden Values on the Every Tag page: the hidden values of the group are now shown.",
      "extractionState" : "manual"
    },
    "Waits before the first frame, so touching the phone doesn't shake it." : {
      "comment" : "Footer under Start Delay in Bracket Settings. On iPad the English names the iPad, and on other devices it says \"device\"; translate each variant. Draft for the Honesty review.",
