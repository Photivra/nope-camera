    "On iPhone, a tap you can feel confirms each press of the shutter and each saved photo.": {
      "comment": "Accessibility screen: haptic feedback. iPhone is a product name; keep it unchanged.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf dem iPhone bestätigt ein spürbares Tippen jedes Drücken des Auslösers und jedes gesicherte Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En el iPhone, un toque que puedes sentir confirma cada pulsación del obturador y cada foto guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur iPhone, une vibration légère confirme chaque pression sur le déclencheur et chaque photo enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su iPhone, un tocco percepibile conferma ogni pressione dell’otturatore e ogni foto salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhoneでは、シャッターを押すたびと写真が保存されるたびに、触覚フィードバックで知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone에서는 셔터를 누를 때와 사진이 저장될 때마다 진동으로 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op iPhone bevestigt een voelbare tik elke druk op de sluiterknop en elke bewaarde foto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No iPhone, um toque que você sente confirma cada clique do obturador e cada foto salva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 iPhone 上，每次按下快门和每张照片存储后都会有可感知的轻触反馈。"
          }
        },
        "zh-Hant": {
