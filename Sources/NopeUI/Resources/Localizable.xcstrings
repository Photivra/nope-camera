        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라가 켜져 있지 않아 렌즈와 카메라 값이 바뀌지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera staat niet aan, dus de lens en camerawaarden zijn niet gewijzigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A câmera não está ligada, então a lente e os valores da câmera não mudaram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
