          }
        }
      }
    },
    "The camera works only when nope. fills the screen.": {
      "comment": "Shown on iPad in Split View, Slide Over or Stage Manager. Keep \"nope.\" unchanged: it is the app's name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera funktioniert nur, wenn nope. den ganzen Bildschirm einnimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cámara solo funciona cuando nope. ocupa toda la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo ne fonctionne que lorsque nope. occupe tout l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera funziona solo quando nope. occupa tutto lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラは nope. が画面全体に表示されているときだけ使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라는 nope.가 전체 화면일 때만 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera werkt alleen als nope. het hele scherm vult."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A câmera só funciona quando o nope. ocupa a tela inteira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有在 nope. 占满整个屏幕时才能使用相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相機只有在 nope. 佔滿整個螢幕時才能使用。"
          }
        }
      }
    },
    "The next photo won't fit. Free up storage on this device to keep taking photos.": {
      "comment": "Explanation of the Storage Full warning on the camera: saving another photo would fail until the person frees storage.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das nächste Foto passt nicht mehr. Gib Speicher auf diesem Gerät frei, um weiter zu fotografieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La próxima foto no cabrá. Libera espacio en este dispositivo para seguir tomando fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La prochaine photo ne tiendra pas. Libérez de l’espace sur cet appareil pour continuer à prendre des photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La prossima foto non entrerà. Libera spazio su questo dispositivo per continuare a scattare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "次の写真は保存できません。撮影を続けるには、このデバイスのストレージを空けてください。"
          }
