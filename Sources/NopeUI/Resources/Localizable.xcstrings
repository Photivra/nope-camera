    "Shows the live picture in red too. Only the screen changes; photos keep their colors.": {
      "comment": "Explains the Red Viewfinder switch, shown while night mode is on.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt auch das Livebild in Rot. Nur der Bildschirm ändert sich; Fotos behalten ihre Farben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra también la imagen en directo en rojo. Solo cambia la pantalla; las fotos conservan sus colores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche aussi l'image en direct en rouge. Seul l'écran change ; les photos gardent leurs couleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra in rosso anche l'immagine dal vivo. Cambia solo lo schermo; le foto mantengono i loro colori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ライブ映像も赤で表示します。変わるのは画面だけで、写真の色はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실시간 화면도 빨간색으로 표시합니다. 화면만 바뀌며 사진의 색은 그대로입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toont ook het livebeeld in rood. Alleen het scherm verandert; foto's houden hun kleuren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra também a imagem ao vivo em vermelho. Só a tela muda; as fotos mantêm suas cores."
