            "value": "카메라가 화면을 보내지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera stuurt geen beeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
