    "nope. uses the camera only to take the photos you ask for.": {
      "comment": "Explains why the app asks for camera access. Keep \"nope.\" unchanged: it is the app's name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. verwendet die Kamera nur, um die Fotos aufzunehmen, die du aufnehmen möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. usa la cámara solo para tomar las fotos que pides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. utilise l’appareil photo uniquement pour prendre les photos que vous demandez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. usa la fotocamera solo per scattare le foto che richiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. がカメラを使うのは、あなたが撮影を指示した写真を撮るときだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope.는 사용자가 요청한 사진을 찍을 때만 카메라를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. gebruikt de camera alleen om de foto’s te maken waar je om vraagt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O nope. usa a câmera apenas para tirar as fotos que você pedir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. 仅在你要求拍照时使用相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nope. 只會在你要求拍照時使用相機。"
          }
