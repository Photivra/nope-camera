    },
    "This lens can't go brighter than frame %lld." : {
      "comment" : "Under a frame in Bracket Settings that the lens can't make as bright as asked. The number is the first frame with the brightest exposure the lens can give.",
      "extractionState" : "manual"
    },
    "This lens can't go darker than frame %lld." : {
      "comment" : "Under a frame in Bracket Settings that the lens can't make as dark as asked. The number is the first frame with the darkest exposure the lens can give.",
      "extractionState" : "manual"
    },
    "Timer, above the shutter, sets a self-timer of 3 or 10 seconds. Burst is beside it: hold the shutter for a burst, or use Start Burst so nothing has to be held. VoiceOver says each second of the countdown." : {
      "comment" : "Accessibility screen: the self-timer and burst. Timer and Burst are the words of the drive strip above the shutter; use their translations. A burst is a rapid run of separate photos. VoiceOver is Apple's screen reader; keep the name unchanged.",
      "extractionState" : "manual"
    },
    "Uncompressed" : {
      "comment" : "In the photo details: the RAW data isn't compressed (TIFF compression 1).",
      "extractionState" : "manual"
    },
    "Up to %lld photos a second" : {
      "comment" : "Detail of the Slow burst speed in the Burst menu. The number is the most photos a second, 2; \"up to\": it can be fewer.",
      "extractionState" : "manual"
    },
    "Use a tripod. Nothing in the picture should move between frames." : {
      "comment" : "Advice in Bracket Settings for a focus bracket.",
      "extractionState" : "manual"
    },
    "Use the Whole Range" : {
      "comment" : "Button in Bracket Settings: sets the focus bracket's range back to 0 to 1.",
