          "stringUnit": {
            "state": "needs_review",
            "value": "無法啟動相機。請試試其他鏡頭。"
          }
        }
      }
    },
    "The camera is in use by another app or a call. It comes back when that ends.": {
      "comment": "Shown over the viewfinder when another app or a phone or video call is using the camera.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera wird von einer anderen App oder einem Anruf verwendet. Sie ist wieder verfügbar, sobald dies endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otra app o una llamada está usando la cámara. Volverá cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo est utilisé par une autre app ou un appel. Il reviendra à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera è in uso da un’altra app o da una chiamata. Tornerà disponibile al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラはほかのアプリまたは通話で使用中です。終了すると再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 앱이나 통화에서 카메라를 사용 중입니다. 끝나면 다시 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera wordt gebruikt door een andere app of een gesprek. Hij komt terug zodra dat is afgelopen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Outro app ou uma ligação está usando a câmera. Ela volta quando isso terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相机正被其他 App 或通话使用，结束后会恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相機正由其他 App 或通話使用中，結束後會恢復。"
          }
        }
      }
    },
    "The camera is paused by the system. It comes back by itself.": {
      "comment": "Shown over the viewfinder when the system pauses the camera for another reason.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das System hat die Kamera pausiert. Sie kommt von selbst zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El sistema ha pausado la cámara. Volverá por sí sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le système a mis l’appareil photo en pause. Il reviendra de lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il sistema ha messo in pausa la fotocamera. Riprenderà da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "システムによりカメラが一時停止しています。自動的に再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템이 카메라를 일시 정지했습니다. 자동으로 다시 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het systeem heeft de camera gepauzeerd. Hij komt vanzelf terug."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O sistema pausou a câmera. Ela volta sozinha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系统已暂停相机，稍后会自动恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "系統已暫停相機，稍後會自動恢復。"
          }
        }
      }
    },
    "The camera is paused to let your device cool down.": {
      "comment": "Shown over the viewfinder when the device is too hot to run the camera.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera ist pausiert, damit dein Gerät abkühlen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cámara está en pausa para que el dispositivo se enfríe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo est en pause pour laisser votre appareil refroidir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera è in pausa per far raffreddare il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デバイスの温度を下げるため、カメラを一時停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기기를 식히기 위해 카메라가 일시 정지되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera is gepauzeerd zodat je apparaat kan afkoelen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A câmera está pausada para o dispositivo esfriar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相机已暂停，让设备降温。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相機已暫停，讓裝置降溫。"
          }
        }
      }
    },
    "The camera isn't sending a picture.": {
      "comment": "Shown over the viewfinder when the camera runs but every picture it delivers is blank, even after the app restarted the camera.",
      "extractionState": "manual",
