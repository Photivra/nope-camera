          }
        }
      }
    },
    "The camera opens with only the viewfinder and the shutter. Warnings about the photo always show.": {
      "comment": "Explains the clean view switch.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera öffnet nur mit Sucher und Auslöser. Warnungen zum Foto werden immer angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cámara se abre solo con el visor y el obturador. Las advertencias sobre la foto siempre se muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo s’ouvre avec seulement le viseur et le déclencheur. Les avertissements sur la photo restent toujours affichés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera si apre solo con il mirino e il pulsante di scatto. Gli avvisi sulla foto vengono sempre mostrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラはビューファインダーとシャッターだけの状態で開きます。写真に関する警告は常に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라가 뷰파인더와 셔터만 있는 상태로 열립니다. 사진에 관한 경고는 항상 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera opent met alleen de zoeker en de sluiterknop. Waarschuwingen over de foto worden altijd getoond."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A câmera abre só com o visor e o obturador. Os avisos sobre a foto sempre aparecem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相机打开时只显示取景器和快门。关于照片的警告始终会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相機開啟時只顯示觀景窗和快門。關於照片的警告一律會顯示。"
          }
        }
      }
    },
    "The camera works only when nope. fills the screen.": {
      "comment": "Shown on iPad in Split View, Slide Over or Stage Manager. Keep \"nope.\" unchanged: it is the app's name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera funktioniert nur, wenn nope. den ganzen Bildschirm einnimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cámara solo funciona cuando nope. ocupa toda la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo ne fonctionne que lorsque nope. occupe tout l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera funziona solo quando nope. occupa tutto lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラは nope. が画面全体に表示されているときだけ使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라는 nope.가 전체 화면일 때만 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera werkt alleen als nope. het hele scherm vult."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A câmera só funciona quando o nope. ocupa a tela inteira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有在 nope. 占满整个屏幕时才能使用相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相機只有在 nope. 佔滿整個螢幕時才能使用。"
          }
        }
      }
    },
    "The photo wasn't taken. Try again.": {
