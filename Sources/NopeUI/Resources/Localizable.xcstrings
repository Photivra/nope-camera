    "This device has no camera that nope. can use.": {
      "comment": "Explains that the device has no usable camera. Keep \"nope.\" unchanged: it is the app's name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Gerät hat keine Kamera, die nope. verwenden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este dispositivo no tiene ninguna cámara que nope. pueda usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet appareil n’a aucun appareil photo que nope. peut utiliser."
          }
        },
        "it": {
