      "extractionState" : "manual"
    },
    "White level: %@" : {
      "comment" : "In the photo details: the RAW file's white level values, as numbers.",
      "extractionState" : "manual"
    },
    "Whole Frame" : {
      "comment" : "Metering mode: the camera measures the whole frame.",
      "extractionState" : "manual"
    },
