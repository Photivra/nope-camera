    "Not every frame fits in the free storage. The frames stop when storage is full.": {
      "comment": "Warning in the night sky helper's settings when the frames chosen may not all fit in the free storage.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht alle Bilder passen in den freien Speicher. Die Aufnahme endet, wenn der Speicher voll ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No caben todos los fotogramas en el almacenamiento libre. Los fotogramas se detienen cuando el almacenamiento está lleno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toutes les images ne tiennent pas dans le stockage libre. Les images s’arrêtent lorsque le stockage est plein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non tutti i fotogrammi entrano nello spazio libero. I fotogrammi si interrompono quando lo spazio è pieno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてのフレームが空きストレージに収まりません。ストレージがいっぱいになると撮影は停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 프레임이 남은 저장 공간에 들어가지 않습니다. 저장 공간이 가득 차면 촬영이 중지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niet alle frames passen in de vrije opslag. De frames stoppen als de opslag vol is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nem todos os quadros cabem no armazenamento livre. Os quadros param quando o armazenamento está cheio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "并非所有帧都能放入可用储存空间。储存空间满时会停止拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "並非所有影格都能放入可用儲存空間。儲存空間已滿時會停止拍攝。"
          }
        }
      }
    },
    "Not saved: nope. isn't allowed to add photos. You can allow it in the Settings app.": {
      "comment": "Shown when the person hasn't allowed the app to add photos to their photo library. Keep the name nope. unchanged, lowercase with its period.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht gesichert: nope. darf keine Fotos hinzufügen. Du kannst es in der App „Einstellungen“ erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se guardó: nope. no tiene permiso para añadir fotos. Puedes permitirlo en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
