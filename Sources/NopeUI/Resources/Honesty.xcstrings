    "This lens can't save unprocessed RAW. Its photos have some device processing.": {
      "comment": "Explains the no-RAW fallback. Must not claim more than the English: the photo IS processed by the device.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Objektiv kann kein unbearbeitetes RAW sichern. Seine Fotos werden vom Gerät teilweise bearbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta lente no puede guardar RAW sin procesar. Sus fotos tienen cierto procesamiento del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet objectif ne peut pas enregistrer de RAW non traité. Ses photos subissent un certain traitement de l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo obiettivo non può salvare RAW non elaborati. Le sue foto hanno una certa elaborazione del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このレンズでは未処理の RAW を保存できません。写真にはデバイスによる処理が一部かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 렌즈는 처리되지 않은 RAW를 저장할 수 없습니다. 사진에 기기 처리가 일부 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze lens kan geen onbewerkte RAW bewaren. De foto’s ervan worden deels door het apparaat bewerkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta lente não pode salvar RAW sem processamento. As fotos dela têm algum processamento do dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此镜头无法保存未经处理的 RAW。其照片会经过部分设备处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此鏡頭無法儲存未經處理的 RAW。其照片會經過部分裝置處理。"
          }
        }
      }
    },
