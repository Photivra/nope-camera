    "Without them, colors are wrong.": {
      "comment": "Why the color data and white balance are always saved. Honesty wording: a fluent human must review every translation before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ohne sie sind die Farben falsch."
