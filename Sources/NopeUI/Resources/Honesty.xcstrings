    "Saved. Not signed: signing is off in Settings.": {
      "comment": "Shown after a photo was saved without a Content Credentials signature because the person turned signing off in the app's settings. Honesty wording: never imply the photo is signed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gesichert. Nicht signiert: Das Signieren ist in den Einstellungen deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guardada. Sin firmar: la firma está desactivada en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrée. Non signée : la signature est désactivée dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salvata. Non firmata: la firma è disattivata nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存しました。署名なし：設定で署名がオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장됨. 서명되지 않음: 설정에서 서명이 꺼져 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bewaard. Niet ondertekend: ondertekenen staat uit in de instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva. Não assinada: a assinatura está desativada nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已存储。未签名：设置中已关闭签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已儲存。未簽署：設定中已關閉簽署。"
          }
        }
      }
    },
    "Saved. Not signed: the signature couldn't be created.": {
      "comment": "Shown after a photo was saved without a Content Credentials signature because creating the signature failed. Honesty wording: never imply the photo is signed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gesichert. Nicht signiert: Die Signatur konnte nicht erstellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guardada. Sin firmar: no se pudo crear la firma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrée. Non signée : la signature n’a pas pu être créée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
