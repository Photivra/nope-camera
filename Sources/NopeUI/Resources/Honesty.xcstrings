    "What each file holds, read on this device. Values are shown on this screen only: nothing is stored or copied.": {
      "comment": "Introduction of the compare view's Details tab. Must not claim more than the English.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was jede Datei enthält, auf diesem Gerät gelesen. Die Werte werden nur auf diesem Bildschirm angezeigt: Nichts wird gespeichert oder kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo que contiene cada archivo, leído en este dispositivo. Los valores solo se muestran en esta pantalla: no se almacena ni se copia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce que contient chaque fichier, lu sur cet appareil. Les valeurs ne s’affichent que sur cet écran : rien n’est stocké ni copié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa contiene ogni file, letto su questo dispositivo. I valori sono mostrati solo su questa schermata: nulla viene memorizzato o copiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各ファイルの内容をこのデバイス上で読み取ったものです。値はこの画面にのみ表示され、何も保存・コピーされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각 파일에 담긴 내용을 이 기기에서 읽은 것입니다. 값은 이 화면에만 표시되며, 아무것도 저장하거나 복사하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wat elk bestand bevat, gelezen op dit apparaat. Waarden worden alleen op dit scherm getoond: er wordt niets opgeslagen of gekopieerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que cada arquivo contém, lido neste dispositivo. Os valores aparecem só nesta tela: nada é armazenado ou copiado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个文件包含的内容，在此设备上读取。这些值仅显示在此屏幕上：不会存储或复制任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個檔案包含的內容，在此裝置上讀取。這些值僅顯示在此畫面上：不會儲存或拷貝任何內容。"
          }
        }
      }
    },
