    "Photos aren't signed: signing is off in Settings.": {
      "comment": "Warning on the camera while the person has turned signing off in the app's settings: new photos get no Content Credentials signature. Honesty wording: never imply photos are signed. Honesty wording: a fluent human must review every translation before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fotos werden nicht signiert: Signieren ist in den Einstellungen ausgeschaltet."
          }
        },
