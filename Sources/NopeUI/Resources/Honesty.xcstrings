{
  "sourceLanguage": "en",
  "strings": {
    "%lld photos saved and signed.": {
      "comment": "Shown after an exposure bracket: each frame was added to the photo library as its own photo, each with a Content Credentials signature. The number is the count of photos, at least 3. Honesty wording: says only that they were saved and signed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld Fotos gesichert und signiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld fotos guardadas y firmadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld photos enregistrées et signées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld foto salvate e firmate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld 枚の写真を保存し、署名しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진 %lld장을 저장하고 서명했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld foto’s bewaard en ondertekend."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld fotos salvas e assinadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已保存并签名 %lld 张照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已儲存並簽署 %lld 張照片。"
          }
        }
      }
    },
    "A photo can't be opened or shown correctly without these. None of them identify you or link your photos.": {
      "comment": "Explains why the locked details are always saved. Must not claim more than the English. Honesty wording: a fluent human must review every translation before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ohne diese Angaben lässt sich ein Foto nicht öffnen oder richtig anzeigen. Keine davon identifiziert dich oder verknüpft deine Fotos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin estos datos, una foto no se puede abrir ni mostrar correctamente. Ninguno te identifica ni vincula tus fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sans eux, une photo ne peut pas être ouverte ni affichée correctement. Aucun ne vous identifie ni ne relie vos photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Senza questi dati una foto non può essere aperta né mostrata correttamente. Nessuno di essi ti identifica o collega le tue foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらがないと、写真を開いたり正しく表示したりできません。いずれもあなたを特定したり、写真同士を結び付けたりしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 정보가 없으면 사진을 열거나 올바르게 표시할 수 없습니다. 어느 것도 사용자를 식별하거나 사진을 서로 연결하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zonder deze gegevens kan een foto niet worden geopend of correct worden weergegeven. Geen ervan identificeert jou of koppelt je foto’s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sem eles, a foto não pode ser aberta nem exibida corretamente. Nenhum deles identifica você ou vincula suas fotos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "缺少这些信息，照片就无法打开或正确显示。这些信息都不会识别你的身份，也不会关联你的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "缺少這些資訊，照片就無法開啟或正確顯示。這些資訊都不會識別你的身分，也不會連結你的照片。"
          }
        }
      }
    },
