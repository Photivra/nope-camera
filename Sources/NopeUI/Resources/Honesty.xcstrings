    "Saved and signed.": {
      "comment": "Shown after a photo was added to the photo library with a Content Credentials signature in every file. Honesty wording: says only that it was saved and signed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gesichert und signiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guardada y firmada."
          }
        },
