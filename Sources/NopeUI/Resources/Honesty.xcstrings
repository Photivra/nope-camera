    "Required by the DNG standard. Editors refuse the file without it.": {
      "comment": "Why the DNG version is always saved. DNG is a file format name. Honesty wording: a fluent human must review every translation before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vom DNG-Standard verlangt. Ohne diese Angabe lehnen Editoren die Datei ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo exige el estándar DNG. Sin esto, los editores rechazan el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exigé par la norme DNG. Sans cela, les éditeurs refusent le fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richiesto dallo standard DNG. Senza questo dato, gli editor rifiutano il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "DNG規格で必須です。これがないと、編集アプリはファイルを開きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "DNG 표준에서 필수입니다. 이 정보가 없으면 편집기가 파일을 거부합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vereist door de DNG-standaard. Zonder dit weigeren editors het bestand."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exigido pelo padrão DNG. Sem isso, os editores recusam o arquivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "DNG 标准要求此项目。缺少此信息，编辑器会拒绝打开文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
