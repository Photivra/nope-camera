      "extractionState" : "manual"
    },
    "Lens and camera names are off in Settings, so the files don't hold them." : {
      "comment" : "Footer of the Lens and Camera group in the photo details when the files hold no lens or camera names: the lens shown is the one that was selected. Draft wording for the Honesty review.",
      "extractionState" : "manual"
    },
    "Lens Correction Instructions" : {
      "comment" : "Metadata item: instructions editors can use to correct lens distortion. Honesty wording: a fluent human must review every translation before release.",
      "extractionState" : "manual"
    },
    "Lens Make and Model" : {
