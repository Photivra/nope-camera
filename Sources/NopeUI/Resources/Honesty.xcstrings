    "Each frame is a separate single-frame photo. Nothing is merged.": {
      "comment": "Explains exposure bracketing. Must not claim more than the English: the photos are never combined.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedes Bild ist ein eigenes Einzelbildfoto. Nichts wird zusammengeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada fotograma es una foto independiente de un solo fotograma. No se combina nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque image est une photo distincte à image unique. Rien n’est fusionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni fotogramma è una foto separata a fotogramma singolo. Nulla viene unito."
          }
        },
        "ja": {
          "stringUnit": {
